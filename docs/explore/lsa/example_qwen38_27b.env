# Server-side only. Source this in the process that launches vLLM.
# Clients, extra_body, chat templates, and gateways do not carry VLLM_LSA
# and must not grow a field for it.
#
#   set -a
#   source docs/explore/lsa/example_qwen38_27b.env
#   set +a
#   MODEL=/path/to/Qwen3.8-27B-AWQ VENV=/path/to/venv \
#     bash tools/rdna/serve_rdna.sh RECIPE=27b-awq
#
# VLLM_LSA=0 is the default even if this file is not sourced.
# VLLM_LSA=1 arms the guard and still runs exact attention.
# Any other value fails closed at model init. Do not set it here.

VLLM_LSA=0

# The real indexer, when it exists, has to turn prefix caching off or salt
# the block hash. This file does neither. See TESTPLAN.md.
# MTP=0
# ENABLE_PREFIX_CACHING=0
