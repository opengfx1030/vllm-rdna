# Example only. Do not copy into tools/rdna/recipes/. The launcher recipes
# stay as they are. Export these on one serve, on top of RECIPE=flashnext.
#
#   MODEL=/path/to/w4a16 VENV=/path/to/venv \
#     VLLM_RDNA_RIDGEFILL=1 \
#     VLLM_RDNA_RIDGEFILL_MAP=/path/to/refit \
#     VLLM_RDNA_RIDGEFILL_PINS=/path/to/checkpoint-pins.json \
#     VLLM_RDNA_RIDGEFILL_MAP_DTYPE=fp16 \
#     ENABLE_PREFIX_CACHING=0 MTP=0 \
#     bash tools/rdna/serve_rdna.sh RECIPE=flashnext
#
# This draft refuses to boot if MTP is on or prefix caching is on.
# It does not yet skip late layers. The flag installs the guards and the
# split-boundary check. Cache-write from the prediction is the GPU follow-up.

VLLM_RDNA_RIDGEFILL=1
VLLM_RDNA_RIDGEFILL_MAP=/path/to/refit
VLLM_RDNA_RIDGEFILL_PINS=/path/to/checkpoint-pins.json
VLLM_RDNA_RIDGEFILL_MAP_SHA=
VLLM_RDNA_RIDGEFILL_MAP_DTYPE=fp16
VLLM_RDNA_RIDGEFILL_SPLIT=24
VLLM_RDNA_RIDGEFILL_TAIL=2048
VLLM_RDNA_RIDGEFILL_LAMBDA=0.03
VLLM_RDNA_RIDGEFILL_MODE=plain
VLLM_RDNA_RIDGEFILL_APC=off
ENABLE_PREFIX_CACHING=0
MTP=0
