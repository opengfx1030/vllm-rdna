# Qwen3.8-27B HI2 3.0 bpw (quant_method rdna_hint_flex, BlivionIaG/Qwen3.8-27B-HI2-3.0bpw)
# with MTP=2 speculative decoding on two gfx1030 cards, TP=2: the single-user / low-concurrency
# recipe (c <= 4). The drafter is the checkpoint's own dense mtp.* layer, run twice per step.
# Every other key is the one of 27b-hi2-tp2 (tests/tools/rdna/test_hi2_recipe_defaults.py keeps
# the two files equal except MTP). Serving guide, switch table and limits:
# docs/rdna2/hi2-27b-tp2-serving.md.
#
# Scoreboard (quiet protocol, HIP 2,3), arm final-mtp2 against final (MTP=0), c=1, decode tok/s
# per request at 1k/512, 16k/1k, 32k/2k: 85.5 / 68.8 / 58.4 against 45.2 / 34.9 / 28.3; end to
# end 68.6 / 26.9 / 23.9 against 40.3 / 19.7 / 16.8 tok/s. Mean acceptance length 2.31 tokens
# per step at c=1 and c=4. At c=8 it does not pay: 134.0 against 135.4 tok/s (1k/512), 28.6
# against 29.4 (16k/1k), and the inter-token latency tail is long (1k/512 c=8: ITL p99 1.62 s
# against 39.6 ms). Use 27b-hi2-tp2 (MTP=0) from c = 8. The KV pool holds fewer tokens (470,489
# against 512,281 at the same 16 GiB reservation).
#
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2-mtp2 MODEL=/path/to/Qwen3.8-27B-HI2-3.0bpw \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3
#
# Override any key after RECIPE= or in the caller's environment (both win over this file), e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2-mtp2 MAXLEN=32768 KV=8589934592
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2-mtp2 VLLM_RDNA_GDN_DECODE_INPLACE=0   # one switch off
#
# Memory per rank (a V620 is 29.98 GiB): CPU accounting of the real TP=2 load (rank 1,
#   unique persistent bytes): hi2 codes 3.80 + block params 0.44 + small hi2 fields 0.04,
#   lm_head 1.18, embed_tokens 1.18, rope cache 0.03 = 6.68 GiB. The engine logs "Model
#   loading took" 7.46 GiB with the switches below off and 6.79-6.80 GiB with them on: the
#   difference is the 48 per-layer GDN state arenas that VLLM_RDNA_GDN_DECODE_INPLACE=1 does
#   not allocate (0.65 GiB, derived), so they are most of the 0.78 GiB gap (not the BF16 MTP
#   layer: the target drops mtp.* at load); about 0.1 GiB stays unexplained. Vision (0.86 GiB)
#   is not loaded with --language-model-only. (MTP=2 adds the drafter: 7.19 GiB.)
# KV cache per rank: 16 full-attention layers x (4 kv heads / TP 2) x 256 head_dim x K+V x
#   2 B = 32 KiB per token, so one 262144-token request (the model's own context, MAXLEN)
#   needs 8 GiB, plus 3 GDN state pages per request (48 layers x 1.5 MiB fp32 SSM + 30 KiB
#   conv = 74 MiB). KV below leaves room for that request plus the prefix cache.

SERVE_ENTRY=cli
SERVED_NAME=q27hi2
PORT=18211
TP=2
HOST=127.0.0.1

MTP=2
ATTN=fa
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
# MAXBAT is derived by the launcher (2048 for an FP16 KV cache: two mamba state blocks).
MAXBAT=
KV=17179869184
GMEM=0.9
RDNA_AR=1
FEATURES="prefix-caching language-model-only"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
# Per-rank JIT: AOT compile hands rank 0's compiled graph to the other ranks on the
# qwen3_next path (TP all-reduce input on cuda:0).
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
# rdna_hint_flex activation path: f16 (spec default), i8 (v_dot4_i32_i8 decode, M <= 48)
# or i8_all (accuracy runs only). docs/rdna2/rdna-hint-flex-weights.md "Compute modes".
VLLM_RDNA_HINT_FLEX_COMPUTE_MODE=f16
# One-shot all-reduce up to 256 KiB, RCCL above. A TP=2 decode step reduces hidden 5120 x
# fp16 = 10 KiB per token (80 KiB at c=8, 240 KiB for a c=8 MTP=2 verify step); prefill
# chunks are 5-20 MiB and stay on RCCL. 2-rank sweep on HIP 2,3 at hidden 5120 (graph replay,
# us per call, one-shot vs RCCL; run during the 2026-11-14 image build, so a same-run relative
# comparison only): 10 KiB 15.3 vs 26.4, 40 KiB 14.9 vs 30.1, 80 KiB 22.5 vs 30.9,
# 240 KiB 29.2 vs 40.8, 640 KiB 62.3 vs 67.3, 1.25 MiB 117.7 vs 114.4. docs/rdna2/hi2-27b-tp2-2026-11-14.md
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
# Decode-stall cap off, as on 27b-awq and full (TP=2 steps are long; the cap would chunk
# a 16k prefill into small pieces). docs/rdna2/mixed-batch-stall-probe.md
VLLM_RDNA_DECODE_STALL_MS=0

# --- HI2 switches: validated, ON in this recipe, OFF in the code (no other recipe or model sees
# them). Scoreboard arm `final` (MTP 0) is this block; per-switch arms, numbers and opt-outs:
# docs/rdna2/hi2-27b-tp2-serving.md. A KEY=value after RECIPE= or in the caller's environment
# wins over every line here; the off value of each switch is on its comment, and
# tests/tools/rdna/test_hi2_recipe_defaults.py keeps this block equal to the doc's switch table.
#
# Decode GEMV for 2..48 rows (c >= 2, MTP verify): the v2 kernel; one row keeps v1.
# Scoreboard 1k/512 c=8: 92.5 -> 117.8 tok/s. Off: v1.
RDNA_HINT_FLEX_GEMV=auto
# Prefill attention (head_dim 256, fp16 KV) as two rocBLAS GEMMs and an in-place softmax per
# query block instead of the flash kernel. TTFT 16k/1k c=1 30.5 -> 24.6 s, 32k/2k 75.8 -> 53.2 s.
# Off: 0.
VLLM_FA_RDNA2_UNFUSED_PREFILL=1
# Gemma-style RMSNorm with a residual: cached fp16 scale and in-place fused add-norm (6 launches
# per call -> 1, 128 calls per step). 1k/512 c=1 33.0 -> 35.3 tok/s. Off: 0.
VLLM_RDNA_GEMMA_RESIDUAL_DIRECT=1
# GDN decode on the paged state in place, no per-layer state arenas (13 or 16 launches per GDN
# layer -> 3; about 0.65 GiB per rank not allocated). 1k/512 c=1 33.0 -> 37.1 tok/s. Needs
# VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0 (set above); otherwise it warns and keeps the arenas. Off: 0.
VLLM_RDNA_GDN_DECODE_INPLACE=1
# SiluAndMul folded into the down projection's activation transform: 64 launches per step
# fewer, bit-identical outputs. Off: 0.
RDNA_HINT_FLEX_FUSE_SILU=1
# LM head (124160 x 5120 per rank) takes the dense gemv for 9..32 rows (MTP verify, 3 rows
# per request). Measured on HIP 4 (docs/rdna2/hi2-27b-tunableop-2026-11-15.md, section 3.3),
# 12 rows: rocBLAS heuristic 11.4 ms, gemv 5.1 ms, rocBLAS with a tuned row 4.9 ms; 24 rows:
# 11.7 / 7.4 / 5.7 ms. The profile ships no LM head row: with the cap at 8 an off-multiple
# step (a prefill row on top of the decode rows) would run rocBLAS at 11+ ms. Off: 8 (the
# previous cap).
VLLM_RDNA_LM_HEAD_GEMV_MAX_M=32
# TunableOp rows: the canonical rocm7.14-rocblas5.5 rows plus the 27B HI2 TP=2 prefill rows
# (gate_up, in_proj_qkvz, qkv, out / o_proj and the 48-row ba at the scheduler's chunk M:
# tunableop/rocm7.14-rocblas5.5-hi2-27b-tp2/README.md, docs/rdna2/hi2-27b-tunableop-2026-11-15.md).
# Soft preference: it applies only when that profile is registered for the loaded
# librocblas build (else the auto-selected canonical rows load, with a warning).
# Off: TUNABLEOP_PREFER= (empty) = the canonical rows; TUNABLEOP_PROFILE=<name> wins over it.
TUNABLEOP_PREFER=rocm7.14-rocblas5.5-hi2-27b-tp2
# Dense HIP prefill GEMM above M = 48 in place of dequant + rocBLAS, where its dispatch table
# measured faster (microbenchmark 1.09-1.12x over tuned rocBLAS at M = 2048; scoreboard arms
# `gemm`, `final2`, `final2-mtp2`: docs/rdna2/hi2-27b-tp2-serving.md). It is a default of this
# recipe only while the next line is uncommented, and the doc's switch table must say the same
# (a test compares them). Per launch: RDNA_HINT_FLEX_PREFILL_GEMM=hip after RECIPE=.
# Off: RDNA_HINT_FLEX_PREFILL_GEMM=rocblas.
# RDNA_HINT_FLEX_PREFILL_GEMM=hip
