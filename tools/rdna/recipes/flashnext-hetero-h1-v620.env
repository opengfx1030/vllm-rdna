# Flash-Next AWQ-W4A16 + MTP=2, hetero-MoE stage 1 on the V620-ONLY stand-in:
# hub = V620 bus d4 (HIP 1, gfx1030), servers = V620 buses d9 dc df e2 (four
# servers, HIP 2-5): the interim layout since the 2026-11-08 case move (six V620s,
# no W7800; box rules). Spec 6.11: stage 1 is validated here, on GPUs that need no
# W7800, before the real H1 run (flashnext-hetero-h1.env, hub on the W7800)
# gets a lease. The hub is a gfx1030 engine, so its dense / attention / RDNA2
# kernel env is that of flashnext-mtp2.env (TP4 production) with TP1 and no
# all-reduce.
#
# serve_rdna.sh starts the four servers FIRST (tools/rdna/rdna_hetero_launch.sh),
# waits for their ready files, runs the hub, and tears everything down together.
# Hub and servers see disjoint GPUs. The job takes BOTH leases of the interim
# layout: a2 (leaf A = HIP 0,1: the hub on HIP 1) and b4 (leaf B = HIP 2-5: the
# servers); HIP 0 stays out of it. The hub link crosses leaves (Gen4 x8 each): its
# numbers are not the same-switch ones of the design, they are recorded as measured.
#
# 1. The plan (CPU only; hub HIP 1, servers HIP 2-5; the buses decide the
#    devices, the plan's HIP indices are documentation). The T10 plan H1.W1 has
#    130 hub slots per layer (the W7800's 48 GB) and does not fit a ~30 GiB V620
#    hub; H1v.W1 is the same W1 routing statistics solved for the V620 hub (40 slots
#    per layer, hub arch gfx1030; make_plan.sh next to it has the commands):
#      bench_results/2026-11-10_hetero-hub-standin/H1v.W1.plan.json
# 2. Launch:
#      bash tools/rdna/serve_rdna.sh RECIPE=flashnext-hetero-h1-v620 MODEL=<ckpt> \
#          VENV=<venv> VLLM_HETERO_MOE_PLAN=<plan.json>
#    PRINT=1 prints the stanza and the commands without starting anything.
#
# VLLM_HETERO_MOE_PLAN is empty on purpose: the launcher refuses an empty plan.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-hetero-h1-v620 ... MAXLEN=8192

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18098
TP=1
HOST=127.0.0.1
PCI_BUSES="d4"

MTP=2
ATTN=fa
MAXLEN=16384
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=2147483648
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
# TP1: no expert-parallel (the hetero quant method owns the experts).
FEATURES="prefix-caching mamba-align vision-cap"
# The tuned-MoE configs are for the TP4 shapes of the production recipe.
TUNED_CONFIG=0

# --- hetero-MoE ---
VLLM_HETERO_MOE=1
VLLM_HETERO_MOE_PLAN=
VLLM_HETERO_MOE_SERVERS="d9,dc,df,e2"
VLLM_HETERO_MOE_WAIT_MS=2000
VLLM_HETERO_MOE_STATS=0
# Cold-copy rule of the decode steps (flashnext-hetero-h1.env): `row` or `primary`.
VLLM_HETERO_MOE_DECODE_DISPATCH=row
# hx digest check (flush bit 256, decimal): the hub reads VLLM_HX_FLUSH from its own
# environment and every server inherits it (they refuse to start on different values).
# x, ids, weights and the partial outputs are verified end to end on every exchange
# and a mismatch that persists aborts the step. On until the W7800 path is proven;
# VLLM_HX_FLUSH=0 turns it off, any other value is a variant of the transport.
VLLM_HX_FLUSH=256

# --- V620-only box ---
# aiter (imported through flash_attn, in the hub and in every server) runs rocminfo at
# import and raises KeyError for a gfx it does not list: the gfx1030 of a box without a
# gfx1100 agent, i.e. the interim box. The stub (tools/rdna/rdna3/cpu_stubs/rocminfo)
# reports one gfx1100 agent, which is what aiter saw while a W7800 was installed; only
# aiter calls rocminfo. flashnext-hetero-h1.env (W7800 hub) does not need it.
RDNA_ROCMINFO_STUB=1

# --- RDNA vLLM env block ---
# Own cache root: rdna_kill_stale() matches on VLLM_CACHE_ROOT (it also kills the
# servers launched with it).
VLLM_CACHE_ROOT=${HOME}/.cache/vllm-flashnext-hetero-v620
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# 9-32 row decode GEMMs take one split-K kernel (see flashnext-mtp2.env).
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=4194304
# int8-activation MoE prefill kernels of the production recipe.
VLLM_RDNA2_W4A8_SDOT4=1
VLLM_RDNA2_W4A8_BLOCK_M=8
VLLM_RDNA_W4A8_KBLOCK=-1
# The hub is a gfx1030 engine: its routed experts run-to-run bit-identical like the
# servers' (spec 6.9; the launcher sets it for the servers explicitly). Without it
# solo and solo2 of the concurrency probe differ in about half of the items
# (arrival-order fp16 epilogues, hx doc 8.9).
VLLM_RDNA2_MOE_DETERMINISTIC=1
# TP1 has no all-reduce: rdna_ar off, no AR knobs.
VLLM_RDNA_AR=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
