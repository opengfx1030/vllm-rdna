# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP2/EP2 on two Radeon PRO W7800
# (gfx1100, RDNA3, 48 GB), one per PCIe root. Slice S1 of
# docs/rdna2/hetero-moe-design-2026-11-07.md; port notes in
# docs/rdna2/rdna3-flashnext-port-2026-11-07.md.
#
# Launch (PCI buses are the W7800s of the CS25 box; HIP indices move):
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-w2-mtp2 PCI_BUSES="cb 07" \
#       MODEL=<checkpoint> VENV=<venv with a gfx1100 _C / _rocm_C build>
#
# MODEL: wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16 keeps the MTP drafter in BF16
# (model_mtp.safetensors, 4.9 GiB of which 4.7 GiB are the 512 fused experts:
# 2.4 GiB per W7800 at EP2, run by the unquantized-MoE Triton route on gfx1100).
# tools/rdna/quant_mtp_experts.py <src> <dst> (CPU, offline) derives a checkpoint
# whose MTP experts are W4A16 like the main ones (0.65 GiB per rank, the same
# gfx1100 W4A16 MoE kernel); the hetero-MoE design assumes that checkpoint.
#
# Everything below is the SAFE BASELINE: no gfx1030 HIP kernel family is
# switched on (VLLM_RDNA3_HIP_OPS empty), so gfx1100 runs the Triton / torch /
# upstream routes plus the gfx1100 W4A16 MoE kernel. Opt families in one at a
# time after their per-op test passes (docs/rdna2/rdna3-flashnext-port-
# 2026-11-07.md, GPU test plan), e.g.
#   VLLM_RDNA3_HIP_OPS=hc,se,qsa,gdn   (add dense, ar, v1 last)
# The same names work on the command line: ... VLLM_RDNA3_HIP_OPS=hc.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-w2-mtp2 MAXLEN=32768 PORT=18101

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18097
TP=2
HOST=127.0.0.1
# The two W7800 of the CS25 box (one per PCIe root). An explicit
# HIP_VISIBLE_DEVICES from the caller wins over this.
PCI_BUSES="cb 07"

MTP=2
# ATTN=none: no --attention-backend flag. The 12 QSA layers and the MTP layer
# bind Qwen4ExpQSAFlashAttentionBackend themselves, and RDNA_ATTN (FA-RDNA2) is
# a gfx1030 backend.
ATTN=none
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"
# The tuned-MoE Triton configs and the TunableOp rows in this tree are gfx1030
# artefacts: the TunableOp registry matches on the librocblas build only, and a
# row is a solver index of the architecture that produced it, so a gfx1030 row
# on gfx1100 selects the wrong solution. Keep both off until gfx1100 rows exist
# (tools/rdna/prof/tune_missing_gemms.sh, TunableOp ordinals of the W7800s).
TUNED_CONFIG=0
TUNABLEOP=0

# --- RDNA vLLM env block ---
# Separate cache roots keep rdna_kill_stale() (it matches on VLLM_CACHE_ROOT)
# from killing a gfx1030 server that shares the tree.
VLLM_CACHE_ROOT=${HOME}/.cache/vllm-flashnext-w7800
VLLM_USE_V2_MODEL_RUNNER=1
# gfx1030 HIP kernel families on gfx1100 (empty = none; see header).
VLLM_RDNA3_HIP_OPS=
# Fixed-point (order-independent) accumulation in the gfx1100 W4A16 MoE GEMMs;
# 0 keeps the fp16 CAS atomic epilogue.
VLLM_RDNA3_MOE_DETERMINISTIC=0
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# 9-32 row split-K GEMM (rdna_gemm_smallm): a gfx10x route, only reachable on
# gfx1100 with the "dense" family; off until A/B'd.
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=0
# W4A8 (int8-activation) MoE/dense kernels are gfx1030 sdot4 code; the gfx1100
# routed experts use the W4A16 kernel for every token count.
VLLM_RDNA2_W4A8_SDOT4=0
# rdna_ar one-shot all-reduce over peer VRAM is off (RCCL) until the 2-rank
# cross-root test passes; enable with VLLM_RDNA3_HIP_OPS=...,ar and VLLM_RDNA_AR=1.
VLLM_RDNA_AR=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 4 HW queues (launcher default 2): the gfx1030 TP4 ABBA of 2026-11-06 picked
# 4; not re-measured on gfx1100.
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
