# Inkling-2-Mini on FOUR gfx1030 cards (V620, 29.98 GiB each), TP=4, with DSpark speculative
# decoding: the model's own draft (mtp.safetensors in the checkpoint directory) proposes 7
# tokens per step and the engine verifies 2 of them for 1..2 concurrent requests, dropping the
# draft cleanly at 3..8 requests (DFlashCudaGraphManager caps draft graphs to batch 1..2 so
# higher SEQS adds no dead draft graphs). Fits the full 1,048,576-token context on 4x V620.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp4-dspark MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3,4,5

# shellcheck source=tools/rdna/recipes/inkling2-mini-tp4.env
source "$RDSE_RECIPES/inkling2-mini-tp4.env"

SEQS=8
MAXLEN=1048576
SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]]}'
