# Inkling-2-Mini on ONE gfx1030 card (V620, 29.98 GiB), TP=1, with DSpark speculative decoding: the
# model's own draft (mtp.safetensors, which has to sit in the checkpoint directory) proposes 7
# tokens per step and the engine verifies 2 of them for 1..2 requests and drops the draft cleanly
# at 3..16 requests ([[1,2,2],[3,16,0]]). Everything else is inkling2-mini-tp1: FULL_AND_PIECEWISE
# HIP graphs, prefix caching, prompt-tokens-details, one image per prompt. Draft, kernels, measured
# tables and lossless verification: docs/rdna2/inkling2-dspark.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1-dspark MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2
#
# Switches (env or trailing KEY=value):
#   ADAPTIVE=1             adaptive K (0..7 at b=1, <=2 at b=2, [[1,1,7],[2,2,2],[3,16,0]], MAXLEN=125000)
#   DRAFT_VOCAB=/path.npy  optional 32,768-id draft vocabulary (tools/rdna/inkling2/draft_vocab.py; zero-copy lm_head)
#   SPEC_CONFIG=           drop the draft (or use RECIPE=inkling2-mini-tp1 for full 194,000 ctx)

# shellcheck source=tools/rdna/recipes/inkling2-mini-tp1.env
source "$RDSE_RECIPES/inkling2-mini-tp1.env"

SEQS=16
if [[ ${ADAPTIVE:-0} == 1 ]]; then
    MAXLEN=125000
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,1,7],[2,2,2],[3,16,0]],"speculator_options":{"adaptive_k":{},"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,1,7],[2,2,2],[3,16,0]],"speculator_options":{"adaptive_k":{}}}'
    fi
else
    MAXLEN=135000
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,16,0]],"speculator_options":{"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,16,0]]}'
    fi
fi
