# Flash-Next AWQ-W4A16 + MTP=2, hetero-MoE stage 1 (H1): ONE island = a hub
# engine (vLLM TP1/EP1 on one Radeon PRO W7800, gfx1100, PCI bus cb) plus four
# expert-server processes, one per V620 (gfx1030, buses ce d3 d8 db), all on one
# PCIe switch. docs/rdna2/hetero-moe-design-2026-11-07.md sections 6.10, 6.11.
#
# serve_rdna.sh starts the four servers FIRST (tools/rdna/rdna_hetero_launch.sh),
# waits until each has written its ready file, runs the hub engine, and tears
# everything down together (a dead server stops the hub with exit 3; the hub's
# exit stops the servers). Servers see ONLY their own V620 (HIP_VISIBLE_DEVICES
# set per server, disjoint from the hub's); their logs and ready files are in
# ${RUN_CWD:-<tree>/cache/run}/hetero (HETERO_LOG_DIR).
#
# The servers are the V620 that TP4 slot A uses, so this recipe NEVER runs
# together with the TP4 slot A engine.
#
# 1. The plan (CPU only, numpy + regex; the uniform stripe of one island):
#      python vllm/distributed/hetero_moe/cli.py stripe --out <plan.json>
#    (defaults: hub HIP 0, expert HIP 1,2,3,4, switch c0, stripe 4; the plan's
#    HIP indices are documentation, the buses below decide the devices).
# 2. Launch:
#      bash tools/rdna/serve_rdna.sh RECIPE=flashnext-hetero-h1 MODEL=<ckpt> \
#          VENV=<venv> VLLM_HETERO_MOE_PLAN=<plan.json>
#    VENV must carry the gfx1100 torch / rocm-sdk device packages (a gfx1030-only
#    venv dies on the W7800 with hipErrorInvalidImage); the servers use the same
#    VENV and PYTHONPATH.
#    PRINT=1 prints the stanza (plan, hubs, servers with bus/HIP/log, the exact
#    server commands) and the hub command without starting anything.
#
# VLLM_HETERO_MOE_PLAN is empty on purpose: the launcher refuses an empty plan.
# Knobs of the launcher (shell variables): HETERO_PYTHON, HETERO_LOG_DIR,
# HETERO_READY_TIMEOUT (900 s), HETERO_TERM_TIMEOUT (30 s), HETERO_SERVER_ARGS.
#
# Hub side is the SAFE BASELINE of flashnext-w2-mtp2.env: no gfx1030 HIP kernel
# family is switched on (VLLM_RDNA3_HIP_OPS empty), the tuned-MoE configs and
# TunableOp rows (gfx1030 artefacts) are off. TP1 has no all-reduce.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-hetero-h1 ... MAXLEN=32768 PORT=18101

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18099
TP=1
HOST=127.0.0.1
# The hub: the W7800 on switch c0. An explicit HIP_VISIBLE_DEVICES from the
# caller wins over this. The server buses are VLLM_HETERO_MOE_SERVERS below.
PCI_BUSES="cb"

MTP=2
# ATTN=none: no --attention-backend flag (the QSA layers and the MTP layer bind
# their own backend; RDNA_ATTN is a gfx1030 backend).
ATTN=none
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
# 10 GiB. The design (5.2a) leaves 12.1 GiB for the KV cache with 130 slots per
# layer; T6-H1 raises this towards that figure after measuring the free memory
# of the W7800 with the real plan loaded.
KV=10737418240
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
# TP1/EP1: no expert-parallel (the hetero quant method owns the experts).
FEATURES="prefix-caching mamba-align vision-cap"
TUNED_CONFIG=0
TUNABLEOP=0

# --- hetero-MoE ---
VLLM_HETERO_MOE=1
VLLM_HETERO_MOE_PLAN=
# Server PCI buses per island (';' between islands, ',' between buses), mapped
# in plan order onto the island's expert devices.
VLLM_HETERO_MOE_SERVERS="ce,d3,d8,db"
VLLM_HETERO_MOE_WAIT_MS=2000
VLLM_HETERO_MOE_STATS=0
# Cold-copy rule of the decode steps (spec C.5, user decision 16): `row` sends a cold
# pair to copy (row + layer) % n_cold on every step (as built); `primary` sends it to
# the first listed copy on graph steps at the capture widths (eager and prefill steps
# keep `row`), with the plan's spill K table of that rule. Decided after the first
# W7800 run: boot row, primary, primary, row with the same plan and compare.
VLLM_HETERO_MOE_DECODE_DISPATCH=row
# hx digest check (flush bit 256, decimal): the hub reads VLLM_HX_FLUSH from its own
# environment and every server inherits it (they refuse to start on different values).
# x, ids, weights and the partial outputs are verified end to end on every exchange
# and a mismatch that persists aborts the step. On until the W7800 path is proven
# (HxServer's open one-in-1.2M combine mismatch); VLLM_HX_FLUSH=0 turns it off.
VLLM_HX_FLUSH=256

# --- RDNA vLLM env block ---
# Own cache root: rdna_kill_stale() matches on VLLM_CACHE_ROOT (it also kills the
# servers launched with it).
VLLM_CACHE_ROOT=${HOME}/.cache/vllm-flashnext-hetero-h1
VLLM_USE_V2_MODEL_RUNNER=1
# gfx1030 HIP kernel families on gfx1100 (empty = none).
VLLM_RDNA3_HIP_OPS=
# Fixed-point (order-independent) accumulation in the gfx1100 W4A16 MoE GEMMs
# of the hub, required for a reproducible hub (spec 9.6).
VLLM_RDNA3_MOE_DETERMINISTIC=1
# Spec 6.9 names VLLM_RDNA2_MOE_DETERMINISTIC for the hub as well (the servers get it
# explicitly from the launcher): the RDNA2 MoE method and the sampler's tie-stable
# top-k read it (sampler.cu accepts either name).
VLLM_RDNA2_MOE_DETERMINISTIC=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=0
# W4A8 sdot4 is gfx1030 code: off for the hub (the servers get it on
# explicitly from the launcher).
VLLM_RDNA2_W4A8_SDOT4=0
# TP1 has no all-reduce.
VLLM_RDNA_AR=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
