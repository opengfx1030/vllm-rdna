# Flash-Next AWQ-W4A16 + Inco DFlash2, TP4/EP4 on gfx1030.
# The DFlash2 checkpoint is a drafter, not the MODEL target. Download it before
# serving because the RDNA launcher defaults to HF_HUB_OFFLINE=1.
# Override SPEC_CONFIG with a local model path when using a separate cache.
# DFLASH_TOKENS=3 favors 1k/512 c=8; DFLASH_TOKENS=2 favors 16k/1k c=8.
# Set DFLASH_TOKENS in the caller environment (the recipe expands it while
# loading). MTP sets the verification capture ladder; SPEC_CONFIG replaces MTP.

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

DFLASH_TOKENS=${DFLASH_TOKENS:-3}
MTP=$DFLASH_TOKENS
SPEC_CONFIG="{\"method\":\"dflash\",\"model\":\"incoai/Qwen3.8-Flash-Next-DFlash2\",\"num_speculative_tokens\":$DFLASH_TOKENS,\"attention_backend\":\"RDNA_ATTN\"}"
# Flash-Next's QSA owner uses native HIP sparse decode under MonoKernel.
# FA-RDNA2 is available for ordinary attention; this QSA checkpoint bypasses it.
# DFlash2's BF16, non-causal sliding-window draft uses FA-RDNA2 via RDNA_ATTN.
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align language-model-only skip-mm-profiling"
EXTRA_ARGS=--monokernel

VLLM_USE_V2_MODEL_RUNNER=1
RDNA_DFLASH2_DRAFT_BF16=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_QSA_HIP=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
