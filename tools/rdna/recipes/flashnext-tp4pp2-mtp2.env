# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP4 x PP2 over both V620 slots of par1-cs25:
# stage 0 = slot A (buses ce d3 d8 db, root c0), stage 1 = slot B (buses 0a 0f 14 17, root 00).
# Derived from flashnext-mtp2 (TP4). Evidence, memory table and the TP8 vs TP4 x PP2 vs TP4
# comparison: docs/rdna2/tp8-pp2-flashnext-2026-11-06.md.
#
# What differs from flashnext-mtp2:
#  - PP=2, PP_PARTITION=24,24 (target layers; the MTP drafter and the lm_head live on stage 1),
#    PCI_BUSES in rank order (stage 0 first). Only the PP pair traffic (a hidden-state send per
#    step) crosses the two roots; the TP and EP groups of 4 stay inside one switch.
#  - KV=13958643712 (13 GiB). The scheduler's block count is the minimum over the stages; the
#    limiting stage 1 holds 7 KiB of KV per token and GPU (6 QSA layers plus the drafter's), so
#    13 GiB are ~1.72M tokens (6.6x a 262k request; flashnext-mtp2: 267k). Stage 1 peaks at
#    18.8 GiB driver memory per GPU at a 3.75 GiB cache, so 13 GiB leaves 1.9 GiB at the
#    activation peak (flashnext-mtp2: 1.7). A fixed KV skips the memory profile, so this
#    number is not checked against GMEM at launch: size it from the doc's memory table.
#  - The target lm_head is built on the last stage only (251917a5a1); before it stage 0 also
#    loaded and kept it, 0.30 GiB per GPU.
#  - TunableOp: rows for ordinals 0-7 (3330 per rank): stage 0 uses 0-3 and stage 1 uses 4-7, which
#    the shipped TP4 rows did not cover (default rocBLAS). The new rank files are proven by an
#    ABBA of this recipe with the 593-row set (the 592 shipped rows leave out one TP8 decode
#    shape): ITL p50 at c8 -10 %, output +5 to +9 % (docs/rdna2/tp8-pp2-flashnext-2026-11-06.md).
#  - Decode steps pass both stages, so c1 ITL is 3.6 % above TP4 (23.2 ms against 22.4); the gain
#    is prefill (the two stages work on different 2048-token chunks: 16k TTFT 3.56 s against 5.52 s,
#    -36 %) and tokens per GiB of KV.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-tp4pp2-mtp2
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-tp4pp2-mtp2 PLE=int4-disk PLE_QUANT_DIR=/path/to/ples_int4

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18099
TP=4
PP=2
PP_PARTITION=24,24
PCI_BUSES="ce d3 d8 db 0a 0f 14 17"
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=13958643712
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block (same as flashnext-mtp2: the TP and PP groups are 4 and 2 ranks) ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=4194304
VLLM_RDNA2_W4A8_SDOT4=1
VLLM_RDNA2_W4A8_BLOCK_M=8
VLLM_RDNA_W4A8_KBLOCK=-1
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
