# Experimental Flash-Next dense-GDN / AWQ MoE PP1/TP3, optional native MTP2.
# Ported to current rdna_extras; NOT freshly GPU-qualified. Size KV for your host.
# No EP/SP/CP, no ReplaySSM/LeapQuant, unquantized 128-wide GDN and vision.
# rdna_moe_tp_group_size MUST match the checkpoint's trained AWQ group size.
SERVE_ENTRY=api
SERVED_NAME=flash-next
HOST=127.0.0.1
PORT=18096
TP=3
PP=1
MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=auto
GMEM=0.94
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="prefix-caching mamba-align vision-cap"
EXTRA_ARGS='--additional-config {"rdna_moe_output_fp32":true,"rdna_moe_tp_group_size":128,"rdna_vision_uneven_tp":true}'
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=1
VLLM_RDNA_DENSE_INT8_ONLY=1
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA2_MOE_FP32_ACCUM=1
VLLM_RDNA2_W4A8_SDOT4=0
VLLM_RDNA_AR=0
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
