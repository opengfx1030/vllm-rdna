# Qwen3.8-27B AWQ-INT4 (compressed-tensors W4A16, dense hybrid GDN) on gfx1030.
# Reference: tools/rdna/serve_gfx1030_27b_dense.sh. No max-model-len (the model's
# own context is used), FA-RDNA2 attention, RDNA2 W4A16/W4A8 GEMMs, prefix
# caching, FULL_AND_PIECEWISE graphs.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-awq MTP=2 W4A8=0
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-awq EAGER=1 MAXLEN=32768
#
# W4A8 knob -> VLLM_RDNA2_W4A8_SDOT4; RDNA_AR knob -> VLLM_RDNA_AR (mapped by
# the entry point so both stay overridable).
#
# W4A8=1: int8-activation prefill GEMMs (M >= 33; decode stays W4A16).
# Measured 2026-10-25 on this tree (4x V620 TP=4 F&P, HIP 6-9, one boot,
# raw PASS, same recipe and decode-stall cap on both sides): the fitted
# prefill cost drops from 0.94-1.15 to 0.70-0.93 ms/token, the 16k c=1
# prefill rate goes 860 -> 1075 tok/s (TTFT 19.1 -> 15.2 s) and the 16k c=8
# aggregate output 42.5 -> 52.3 tok/s (TTFT 48.8 -> 34.4 s). Quality is
# unchanged: paired PPL 4.94 -> 4.91, greedy 3/3 on both sides. The W4A8
# path is active on every rank (the serve log says "RDNA2 W4A8 sdot4 path
# active").
# The same lever on v0.31 (2026-10-09) gave byte-identical greedy output and
# PPL 4.90 vs 4.94.
# Set 0 to fall back to the W4A16 prefill GEMMs.

SERVE_ENTRY=cli
SERVED_NAME=q27d
PORT=18210
TP=4
HOST=127.0.0.1

MTP=0
ATTN=fa
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=
BLOCK_SIZE=1024
SEQS=8
# MAXBAT is derived by the launcher from the KV/SSM dtype (2048 for an FP16
# KV cache, 4096 for a packed KV cache with an FP16 SSM state, 6144 with the
# model's own FP32 state): a prefill chunk ends on a mamba state block
# boundary, so the budget must cover two blocks. Pinning it here would defeat
# that derivation and put a packed KV cache back on a one-block budget.
MAXBAT=
KV=8000000000
GMEM=0.9
W4A8=1
RDNA_AR=1
FEATURES="prefix-caching mamba-align language-model-only vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
# AOT compile hands rank 0's compiled graph to the other ranks on the
# qwen3_next path (TP all-reduce input on cuda:0; same on 0.28). Per-rank JIT.
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; the stock custom-AR force flag stays off.
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1

# Decode-stall cap (dense hybrid): bound prefill tokens in steps that carry
# decodes (dense models fit on all prefill steps). Off here: now that the
# prefill budget is derived from the mamba state block, the cap only chunks
# the prefill below that boundary. Measured 2026-10-25 on this tree (4x V620
# TP=4 F&P, HIP 6-9, one boot, raw PASS): the cap costs 12-19 % TTFT at c=8
# (1k FP16 KV 1.96 -> 1.62 s, 16k INT4 KV 39.53 -> 34.89 s) for 0-2.5 %
# output; the c=1 cells are within noise. It does bound the decode gap
# during a long prefill (on the INT4 KV cache the worst-request mean ITL at
# 16k c=8 grows 415 -> 503 ms with the cap off). Set a positive value to
# trade TTFT for that bound.
# docs/rdna2/mixed-batch-stall-probe.md
VLLM_RDNA_DECODE_STALL_MS=0
