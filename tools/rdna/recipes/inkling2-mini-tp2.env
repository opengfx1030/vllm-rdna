# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration) on TWO
# gfx1030 cards (V620, 29.98 GiB each), TP=2: DSpark speculative decoding ON by default (K=2 for
# 1..2 requests, dropped cleanly at 3..8 via [[1,2,2],[3,8,0]]), FULL_AND_PIECEWISE HIP graphs,
# one-shot HIP all-reduce (rdna_ar), prefix caching, prompt-tokens-details and images. Serving
# guide and measured tables: docs/rdna2/inkling2-serving.md and docs/rdna2/inkling2-dspark.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp2 MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3
#
# Switches (env or trailing KEY=value):
#   ADAPTIVE=1             adaptive K (0..7, [[1,2,7],[3,8,0]], MAXLEN=720000, TP=2 cost model)
#   DRAFT_VOCAB=/path.npy  optional 32,768-id draft vocabulary (tools/rdna/inkling2/draft_vocab.py)
#   DSPARK=0               plain decoding, full 1,048,576-token context (MAXBAT=320)

SERVE_ENTRY=cli
SERVED_NAME=inkling2-mini
PORT=18222
TP=2
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=0
SEQS=8
KV=auto
GMEM=0.92
RDNA_AR=1
FEATURES="prefix-caching prompt-tokens-details"
EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'

if [[ ${DSPARK:-1} == 0 ]]; then
    MAXLEN=1048576
    MAXBAT=320
    SPEC_CONFIG=""
elif [[ ${ADAPTIVE:-0} == 1 ]]; then
    MAXLEN=720000
    MAXBAT=1024
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,7],[3,8,0]],"speculator_options":{"adaptive_k":{},"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,7],[3,8,0]],"speculator_options":{"adaptive_k":{}}}'
    fi
else
    MAXLEN=760000
    MAXBAT=1024
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]],"speculator_options":{"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]]}'
    fi
fi

# --- RDNA vLLM env block ---
TUNABLEOP=0
# Floor of the headroom the KV sizing keeps free beyond its measured transient peak, in MiB
# (unset: 3 GiB on ROCm). Set empty to restore the engine default (the context then shrinks).
VLLM_KV_CACHE_MARGIN_FLOOR_MIB=2048
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
