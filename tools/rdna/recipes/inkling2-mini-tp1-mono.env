# Inkling-2-Mini on ONE gfx1030 card (V620, 29.98 GiB), TP=1, with persistent decode
# MoE monokernel enabled (`VLLM_INKLING2_MONOKERNEL=1`): fuses router + w13 + SwiGLU + w2
# inside one launch for single-token decode (`MONO_MAX_ROWS=1`), while multi-token decode
# and prefill stay on the continuous-batching path (`docs/rdna2/inkling2-serving.md`).
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1-mono MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2

# shellcheck source=tools/rdna/recipes/inkling2-mini-tp1.env
source "$RDSE_RECIPES/inkling2-mini-tp1.env"

# --- RDNA vLLM env block ---
VLLM_INKLING2_MONOKERNEL=1
VLLM_INKLING2_MONO_MAX_ROWS="${MONO_MAX_ROWS:-1}"
