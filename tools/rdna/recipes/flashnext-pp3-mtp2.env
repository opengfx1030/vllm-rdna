# Flash-Next AWQ-W4A16, MTP=2, pipeline-parallel over 3 gfx1030 cards (TP1/PP3).
# Profile follows alanoo81/flashnext-v620-pp3: partition 17,17,14 (the drafter
# sits on the last stage), 4 sequences, text-only, 262K, KV sized from free
# memory with the CUDA-graph estimate off.
# 30 GB cards: GMEM 0.975 is what fits one full 262K request (stage 0 has
# 2.91 GiB for KV, 2.83 needed; at 0.95 vLLM caps the length at ~188K).
# MAXBAT 2112 = the 2048-token mamba block + 4 seqs x 3 MTP tokens: at 2048 the
# decode tokens leave less than one block per step and 16K c=4 admits only 3.
# Needs the W4A16 drafter checkpoint (tools/rdna/quant_mtp_experts.py): the
# bf16 drafter experts do not fit the last stage. Use it up to ~4 streams;
# beyond that flashnext-pp3 (MTP=0) gives more aggregate throughput.
# Same PLE / dense INT8 / text-only notes as flashnext-pp3.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-pp3-mtp2 MODEL=/path/to/mtpq-model \
#       PLE=int4 PLE_QUANT_DIR=/path/to/ples_int4

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18097
TP=1
PP=3
PP_PARTITION=17,17,14
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=4
MAXBAT=2112
LPTH=0
PREFILL_INTERVAL=1
KV=auto
GMEM=0.975
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_SIZES='[3,6,12]'
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="prefix-caching mamba-align language-model-only skip-mm-profiling"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=1
VLLM_RDNA_DENSE_INT8_ONLY=1
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
