# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP8/EP8 over both V620 slots of par1-cs25
# (slot A = buses ce d3 d8 db on root c0, slot B = buses 0a 0f 14 17 on root 00).
# Derived from flashnext-mtp2 (TP4). Evidence, memory table and the TP8 vs TP4 x PP2 vs TP4
# comparison: docs/rdna2/tp8-pp2-flashnext-2026-11-06.md.
#
# What differs from flashnext-mtp2:
#  - TP=8 with PCI_BUSES in rank order: HIP indices move when cards or switches change, buses do
#    not, and the launcher refuses a bus that is missing. Ranks 0-3 sit on one PLX switch and
#    ranks 4-7 on the other; the one RCCL ring crosses roots twice (24.5 GB/s, nothing to tune).
#  - KV=13958643712 (13 GiB). Weights are 11.23 GiB per GPU at TP8 (20.56 at TP4) and the peak
#    driver memory is 18.9 GiB at a 3.75 GiB cache, so 13 GiB leaves 1.8 GiB at the activation
#    peak: the margin flashnext-mtp2 runs with (1.7 GiB at 3.75 GiB). Each rank keeps one
#    replicated KV head, so TP8 holds the same ~71k tokens per GiB as TP4: 13 GiB = ~925k tokens
#    (3.5x a 262k request; flashnext-mtp2: 267k). A fixed KV skips the memory profile, so this
#    number is not checked against GMEM at launch: size it from the doc's memory table.
#  - All-reduce: one-shot gate 128 KiB (VLLM_RDNA_AR_MAX_KB / _ONESHOT_KB below): at 8 ranks
#    one-shot beats RCCL (134-178 us for anything up to 240 KiB) only up to ~155 KiB (1 x 2560
#    token 29 us, 24 tokens = 120 KiB 107 us vs 134). On a tree with the hierarchical all-reduce
#    (rdna_ar HIER, default auto for a group over both switches, gate VLLM_RDNA_AR_HIER_MAX_KB =
#    1024) every size from 20 KiB takes that path instead: the c8 decode sizes (24 tokens = 120
#    KiB) run island partials and one cross-root exchange, ITL p50 at c8 -11 % (41.8 -> 37.2 ms);
#    the c1 sizes stay under 20 KiB on the flat one-shot, unchanged. Older trees run the flat gate.
#  - TunableOp: rows for ranks 0-7 (3330 per rank, tunableop/rocm7.14-rocblas5.5): the shipped
#    TP4 rows covered ranks 0-3 only, so ranks 4-7 ran every GEMM on the rocBLAS default. The
#    592 TP8 shapes added to all eight rank files give ITL p50 at c8 -3.4 % (ABBA, flat
#    all-reduce) and -3.7 % / -4.1 % at 1k / 16k with the hier all-reduce, output +2.5 to +5.5 %.
#    The 593rd tuned shape (tn_2048_12_2560, the 12-token decode GEMM) is left out: with it a
#    deterministic-MoE concurrency probe flips a token on the flat all-reduce
#    (docs/rdna2/tp8-pp2-flashnext-2026-11-06.md).
#
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-tp8-mtp2
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-tp8-mtp2 PCI_BUSES="ce d3 d8 db 0a 0f 14 17" KV=auto GMEM=0.94

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18098
TP=8
PCI_BUSES="ce d3 d8 db 0a 0f 14 17"
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=13958643712
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block (same as flashnext-mtp2 except the all-reduce gate) ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=4194304
VLLM_RDNA2_W4A8_SDOT4=1
VLLM_RDNA2_W4A8_BLOCK_M=8
VLLM_RDNA_W4A8_KBLOCK=-1
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=128
VLLM_RDNA_AR_ONESHOT_KB=128
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
