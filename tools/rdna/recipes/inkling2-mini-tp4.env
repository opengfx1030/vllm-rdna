# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration) on FOUR
# gfx1030 cards (V620, 29.98 GiB each), TP=4: the model's full 1,048,576-token context with
# FULL_AND_PIECEWISE HIP graphs, prefix caching and images, 4,096 tokens per prefill step. The
# TP=2 layout carried over (attention by KV-head group, MoE intermediate split, vocab-sharded
# lm_head / embedding, one-shot HIP all-reduce inside the graphs). Serving guide, switches, limits
# and the measured tables: docs/rdna2/inkling2-serving.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp4 MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3,4,5
#
# Override any key after RECIPE= or in the caller's environment (both win over this file), e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp4 MAXLEN=262144
#
# Decode ms per token of one request (graph replay, 4,096-token engine; b requests at once):
#   b = 1 11.5, 2 12.7, 4 15.0, 8 19.1, 16 24.6 (eager: 16.9, 17.0, 17.5, 20.7, 25.6).
# Memory per rank: weights 6.21 GiB with the vision tower (5.61 text only), KV 8 KiB per token (a
# 1,048,576-token request needs 8.2 GiB), so the default engine margin (3 GiB on ROCm) stays: the
# pool holds 2,250,192 tokens (2.15 such requests). A 261,052-token prompt prefills at 1,589 tok/s
# and decodes at 17.1 ms/token with the needle found; the device peaked at 25.58 GiB of 29.98.
#
# DSpark (opt-in speculative decoding, docs/rdna2/inkling2-dspark.md) was not run at TP=4. The draft
# is the TP=2 code path, replicated on every rank: 0.8 GiB of weights and 4 KiB of KV per token
# and rank come on top of this recipe's 8 KiB, so 1,048,576 tokens should still fit (about 12.3 GiB
# of KV against a pool of 17.2 GiB) [INFERENCE]. At TP=2 it gives 1.29x at one request and 1.14x
# at two; see the TP=2 recipe for the SPEC_CONFIG line.

SERVE_ENTRY=cli
SERVED_NAME=inkling2-mini
PORT=18223
TP=4
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=0
MAXLEN=1048576
SEQS=8
MAXBAT=4096
KV=auto
GMEM=0.92
RDNA_AR=1
FEATURES="prefix-caching"
EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'

# --- RDNA vLLM env block ---
TUNABLEOP=0
# One-shot all-reduce up to 256 KiB (a decode step of up to 28 tokens reduces 9 KiB per token in
# fp32 after the attention output projection), RCCL above: a 4,096-token prefill step is 36 MiB.
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
