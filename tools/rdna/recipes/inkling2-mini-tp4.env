# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration) on FOUR
# gfx1030 cards (V620, 29.98 GiB each), TP=4: full 1,048,576-token context with DSpark speculative
# decoding ON by default (K=2 for 1..2 requests, dropped cleanly at 3..8 via [[1,2,2],[3,8,0]]),
# FULL_AND_PIECEWISE HIP graphs, one-shot HIP all-reduce (rdna_ar), prefix caching,
# prompt-tokens-details, images and 4,096 tokens per prefill step. Serving guide and measured
# tables: docs/rdna2/inkling2-serving.md and docs/rdna2/inkling2-dspark.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp4 MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3,4,5
#
# Switches (env or trailing KEY=value):
#   ADAPTIVE=1             adaptive K (0..7, [[1,2,7],[3,8,0]], full 1M ctx still fits, TP=4 cost)
#   DRAFT_VOCAB=/path.npy  optional 32,768-id draft vocabulary (tools/rdna/inkling2/draft_vocab.py)
#   DSPARK=0               plain decoding (2.25M KV tokens)

SERVE_ENTRY=cli
SERVED_NAME=inkling2-mini
PORT=18223
TP=4
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=0
MAXLEN=1048576
SEQS=8
MAXBAT=4096
KV=auto
GMEM=0.92
RDNA_AR=1
FEATURES="prefix-caching prompt-tokens-details"
EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'

if [[ ${DSPARK:-1} == 0 ]]; then
    SPEC_CONFIG=""
elif [[ ${ADAPTIVE:-0} == 1 ]]; then
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,7],[3,8,0]],"speculator_options":{"adaptive_k":{},"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,7],[3,8,0]],"speculator_options":{"adaptive_k":{}}}'
    fi
else
    if [[ -n ${DRAFT_VOCAB:-} ]]; then
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]],"speculator_options":{"draft_vocab":"'"$DRAFT_VOCAB"'"}}'
    else
        SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]]}'
    fi
fi

# --- RDNA vLLM env block ---
TUNABLEOP=0
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
