# GLM-5.3-Flash (Glm5Next: 34 KDA + 11 DSA layers, 288 routed experts) as a
# compressed-tensors W4A16 checkpoint (wtdcode/GLM-5.3-Flash-AWQ-W4A16) on
# gfx1030, through the upstream model. First-boot recipe, not a tuned one:
# docs/rdna2/glm5next-gfx1030.md has the path each layer type takes and the
# checklist this recipe is the first step of.
#
#   MODEL=/path/to/GLM-5.3-Flash-AWQ-W4A16 \
#   bash tools/rdna/serve_rdna.sh RECIPE=glm53-flash
#
# Size: with the checkpoint's 288 experts x (3 x 4096 x 2048) over 42 MoE
# layers the routed experts alone are ~304B parameters, ~160 GB at W4A16.
# That is more than 4x V620 (128 GB), so this recipe asks for all 8 GPUs.
# Confirm against the checkpoint's config.json; if TP=8 cannot boot on the
# box (two PLX switches, backlog #67) the PP=2 x TP=4 path of #80/#82 is the
# alternative.
#
# Attention: ATTN=none. The DSA layers select ROCM_AITER_MLA_SPARSE, whose
# NoPE / non-fp8 shape runs the Triton ragged kernel on RDNA (no aiter); the
# KDA layers are Mamba-type (Triton fused_recurrent_kda / chunk prefill).
# VLLM_GLM5_KDA_HIP=1 switches plain decode to the HIP recurrence once it
# has been checked against Triton (tests/models/glm5next/test_rdna_kda_recurrent.py).
#
# Validated production settings (2026-10-20): 12.1 t/s decode, 900 t/s @8k,
# 860 t/s @32k prefill, 331,389-token KV pool, 16.9-minute soak at 140 W.
# MTP is broken on this checkpoint (MTP=1 and MTP=2 both hang on the first
# request and have caused kernel GPU resets); keep MTP=0. CUDA graphs and
# compiled piecewise graphs still produce incoherent decode; stay eager.

SERVE_ENTRY=cli
SERVED_NAME=glm53-flash
PORT=18400
TP=8
GPUIDS=0,1,2,3,4,5,6,7
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=1
# EAGER=0 + the two lines below for the graphed run:
# COMPILATION_CONFIG='{"cudagraph_mode":"FULL_AND_PIECEWISE","compile_ranges_endpoints":[]}'
# VLLM_USE_BREAKABLE_CUDAGRAPH=1
MAXLEN=262144
# kpool indexer: block_size must be a multiple of index_kpool * 32 = 128.
BLOCK_SIZE=1024
SEQS=1
MAXBAT=8192
KV=4000000000
GMEM=0.95
RDNA_AR=1
FEATURES="language-model-only skip-mm-profiling trust-remote-code prefix-caching mamba-align"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
# The 247-commit opengfx1030 base defaults the new RDNA HIP set on. The GLM
# path is validated with the pre-#99 Triton worker/mamba paths; keep the
# umbrella off for this recipe until the HIP path is validated for GLM.
VLLM_RDNA_ALL_HIP=0
VLLM_GLM5_KDA_HIP=1
VLLM_RDNA_MHC=1
VLLM_RDNA_MHC_COMPILE=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
# No tuned MoE configs for 288 experts yet.
TUNED_CONFIG=0
