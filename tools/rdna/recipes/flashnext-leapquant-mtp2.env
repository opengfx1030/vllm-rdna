# Flash-Next AWQ-W4A16 + LeapQuant INT8 GDN, TP4/EP4 on gfx1030.
# Opt-in (--replayssm-state-dtype leapquant), lossy:
# docs/rdna2/leapquant-gdn-2026-11-13.md.
# Window 32 / rank 4 is the serving layout; MTP2 and full graphs stay enabled.
# Measured against flashnext-mtp2 + --monokernel; short cold TTFT is higher.

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1
MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=512
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"
EXTRA_ARGS=--monokernel
REPLAYSSM_STATE_DTYPE=leapquant

VLLM_RDNA_DECODE_STALL_MS=450
VLLM_RDNA_DECODE_SHARE=0
VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=4194304
VLLM_RDNA2_W4A8_SDOT4=1
VLLM_RDNA2_W4A8_BLOCK_M=8
VLLM_RDNA_W4A8_KBLOCK=-1
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
