# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration: 24 layers,
# 128 experts, NVFP4 + MXFP8 MoE, vision tower) on ONE gfx1030 card (V620, 29.98 GiB), TP=1:
# FULL_AND_PIECEWISE HIP graphs, prefix caching, images. Every compute op of the serving path is
# a native HIP kernel (no rocBLAS, no Triton). Serving guide, switches, limits and the measured
# tables: docs/rdna2/inkling2-serving.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=3
#
# Override any key after RECIPE= or in the caller's environment (both win over this file), e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 SEQS=2 MAXLEN=190000   # long context
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 EAGER=1 MAXLEN=200000  # no graphs
#
# Decode ms per token of one request (graph replay, 4,096-token engine; b requests at once):
#   b = 1 19.3, 2 23.2, 4 30.0, 8 39.9, 16 48.2 (eager: 20.4, 24.0, 31.0, 40.7, 50.3).
# Memory: weights 18.68 GiB (vision tower included), capture 0.71 GiB (SEQS 16: sizes 1..16
# decode, 1 2 4 8 16 24 32 mixed), transient peak 0.19 GiB. The KV cache holds 32 KiB per token,
# so MAXLEN is what is left after the weights, the activations and the graphs: 196,065 tokens at
# SEQS 16 (this recipe; the cap below keeps 2,065 tokens of slack).
# A 162,814-token prompt prefills at 648 tok/s and decodes at 31.9 ms/token with
# the needle found; the device peaked at 25.59 GiB of 29.98.
# The model's own limit is 1,048,576 tokens: TP=2 / TP=4 (inkling2-mini-tp2 / -tp4).
#
# DSpark speculative decoding has its own recipe, RECIPE=inkling2-mini-tp1-dspark (this recipe
# with MAXLEN 135000 for K=2 or MAXLEN 125000 for ADAPTIVE=1; docs/rdna2/inkling2-dspark.md): the
# model's own draft proposes 7 tokens and the engine verifies 2 (or 0..7 with ADAPTIVE=1) per step
# for one or two requests, none above:
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1-dspark MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=3
#
# LoopCD (arXiv:2610.02185) server-wide defaults (or override per request via vllm_xargs):
#   LOOPCD_ALPHA=0.25      contrastive strength >= 0 (0 = off, default)
#   LOOPCD_MODE=hidden     hidden (pre-coda state blend, default) or logits (APC logit contrast)
#   LOOPCD_ADAPTIVE=1      uncertainty-adaptive scaling (1 - p_max) * alpha in logits mode
#   LOOPCD_BETA=0.1        APC plausibility cutoff in [0, 1] for logits mode (default 0.1)

SERVE_ENTRY=cli
SERVED_NAME=inkling2-mini
PORT=18221
TP=1
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
# The engine's default grid for this architecture: decode graphs for every request count up to
# min(16, SEQS) (vllm/config/vllm.py), mixed / prefill graphs for 1 2 4 8 16 24 32 tokens.
CG_CAPTURE_SIZES=0
MAXLEN=194000
SEQS=16
MAXBAT=1024
KV=auto
GMEM=0.92
RDNA_AR=0
FEATURES="prefix-caching prompt-tokens-details"
# One image per prompt. The Inkling processor takes no --mm-processor-kwargs, so the launcher's
# vision-cap feature (which adds them) is not used.
EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'

# --- RDNA vLLM env block ---
# No rocBLAS GEMM runs in the Inkling serving path, so no TunableOp rows are loaded.
TUNABLEOP=0
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
