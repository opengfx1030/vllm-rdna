# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration: 24 layers,
# 128 experts, NVFP4 + MXFP8 MoE, vision tower) on ONE gfx1030 card (V620, 29.98 GiB), TP=1:
# FULL_AND_PIECEWISE HIP graphs, prefix caching, images. Every compute op of the serving path is
# a native HIP kernel (no rocBLAS, no Triton). Serving guide, switches, limits and the measured
# tables: docs/rdna2/inkling2-serving.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=3
#
# Override any key after RECIPE= or in the caller's environment (both win over this file), e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 SEQS=2 MAXLEN=190000   # long context
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1 EAGER=1 MAXLEN=200000  # no graphs
#
# Decode ms per token of one request (graph replay, 4,096-token engine; b requests at once):
#   b = 1 19.1, 2 23.3, 4 30.1, 8 39.6, 16 48.7 (eager: 20.1, 23.8, 30.7, 40.4, 50.6).
# Memory: weights 18.68 GiB (vision tower included), capture 0.70 GiB (SEQS 16: sizes 1..16
# decode, 1 2 4 8 16 24 32 mixed). The KV cache holds 32 KiB per token, so MAXLEN is what is
# left after the weights, the activations and the graphs: 180,986 tokens at SEQS 16 (this
# recipe; the cap below keeps 928 tokens of slack), 194,368 at SEQS 2, 201,600 with no graphs.
# A 162,814-token prompt (90% of the fit) prefills at 648 tok/s and decodes at 31.9 ms/token with
# the needle found; the device peaked at 25.59 GiB of 29.98.
# The model's own limit is 1,048,576 tokens: TP=2 / TP=4 (inkling2-mini-tp2 / -tp4).

SERVE_ENTRY=cli
SERVED_NAME=inkling2-mini
PORT=18221
TP=1
HOST=127.0.0.1

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
# The engine's default grid for this architecture: decode graphs for every request count up to
# min(16, SEQS) (vllm/config/vllm.py), mixed / prefill graphs for 1 2 4 8 16 24 32 tokens.
CG_CAPTURE_SIZES=0
MAXLEN=180000
SEQS=16
MAXBAT=1024
KV=auto
GMEM=0.92
RDNA_AR=0
FEATURES="prefix-caching"
# One image per prompt. The Inkling processor takes no --mm-processor-kwargs, so the launcher's
# vision-cap feature (which adds them) is not used.
EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'

# --- RDNA vLLM env block ---
# No rocBLAS GEMM runs in the Inkling serving path, so no TunableOp rows are loaded.
TUNABLEOP=0
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
