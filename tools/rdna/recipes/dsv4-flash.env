# DeepSeek-V4-Flash (K128) on gfx1030: fp8 dense + MXFP4 experts
# (I8 [N, K/2] + F8_E8M0 [N, K/32] scales -> MXF4_RDNA2 MoE).
# Based on docs/fixes/2026-08-14-deepseek-v4-k128-recipe.md (TP=4, 32k,
# 4 seqs, fp8 KV, PIECEWISE graphs).
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=dsv4-flash TP=8 \
#     HIP_VISIBLE_DEVICES=2,3,4,5,6,7,8,9

SERVE_ENTRY=cli
SERVED_NAME=dsv4-flash
PORT=18300
TP=4
HOST=127.0.0.1
MTP=0
ATTN=none
MAXLEN=32768
SEQS=4
MAXBAT=2048
KV=4000000000
GMEM=0.90
COMPILATION_CONFIG='{"cudagraph_mode":"PIECEWISE","compile_ranges_endpoints":[]}'
FEATURES="language-model-only skip-mm-profiling trust-remote-code"
EXTRA_ARGS="--kv-cache-dtype fp8"

VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
NCCL_P2P_LEVEL=pxb
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
TUNED_CONFIG=1
