# DeepSeek-V4-Flash (K128) on gfx1030: fp8 dense + MXFP4 experts
# (I8 [N, K/2] + F8_E8M0 [N, K/32] scales -> MXF4_RDNA2 MoE).
# Based on docs/fixes/2026-08-14-deepseek-v4-k128-recipe.md (TP=4, 32k,
# fp8 KV), fp16 attention via DeepseekV4RDNAAttention.
#
# Cudagraphs: the AMD DeepSeek-V4 model has no torch.compile'd submodule,
# so piecewise capture comes from breakable CUDA graphs: FULL_AND_PIECEWISE
# captures the model with the sparse indexer and MLA attention as eager
# breaks (VLLM_USE_BREAKABLE_CUDAGRAPH=1). With it off, the runner silently
# drops to cudagraph_mode NONE.
#
# The checkpoint is a 50%-pruned repack: judge correctness with
# tools/rdna/port_v031/ppl_probe.py (perplexity ~8.4), not exact answers.
#
# KV budget (TP=4, 4x V620): model 20.73 GiB of 29.4 GiB free; KV=6e9
# (5.59 GiB) holds 107,892 tokens. The compressed/sliding V4 cache grows far
# slower than context: 8 concurrent 16k+1k requests peak at ~40% of it, so
# SEQS=8 runs c=8 without queueing (4e9 would sit at ~64%).
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=dsv4-flash TP=8 \
#     HIP_VISIBLE_DEVICES=2,3,4,5,6,7,8,9

SERVE_ENTRY=cli
SERVED_NAME=dsv4-flash
PORT=18300
TP=4
HOST=127.0.0.1
MTP=0
ATTN=none
MAXLEN=32768
SEQS=8
MAXBAT=2048
KV=6000000000
GMEM=0.90
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_AND_PIECEWISE","compile_ranges_endpoints":[]}'
FEATURES="language-model-only skip-mm-profiling trust-remote-code"
EXTRA_ARGS="--kv-cache-dtype fp8"

VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_USE_BREAKABLE_CUDAGRAPH=1
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
NCCL_P2P_LEVEL=pxb
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
TUNED_CONFIG=1
