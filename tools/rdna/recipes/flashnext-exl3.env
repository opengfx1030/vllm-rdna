# Flash-Next EXL3 (turboderp/Qwen3.8-Flash-Next-exl3, exllamav3 >= 1.4.5) on
# gfx1030, TP4, no MTP. Same serving profile as `flashnext`, with:
# - PLE=exl3: the n-gram table ships as ngram_embedding.safetensors and the CPU
#   sidecar mmaps and decodes it (32.6 GB at ng5, page cache only).
# - Expert parallel on: EXL3 rotates 128-wide blocks of the 640-wide expert
#   intermediate axis, so TP=4 cannot split an expert (160 per rank); with EP
#   every rank holds whole experts and the shared expert is replicated.
# - Fused shared expert and tuned MoE configs off: those are W4A16 MoE paths,
#   EXL3 experts run through Exl3MoEMethod.
# - Text only (language-model-only): see the FEATURES comment below.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-exl3 \
#       MODEL=/path/to/Qwen3.8-Flash-Next-exl3-3.05bpw

SERVE_ENTRY=cli
SERVED_NAME=flash-next-exl3
PORT=18094
TP=4
HOST=0.0.0.0

MTP=0
PLE=exl3
ATTN=fa
MAXLEN=
BLOCK_SIZE=1024
SEQS=6
MAXBAT=2048
LPTH=0
KV=7000000000
GMEM=0.90
DIST_TIMEOUT=1800
CG_MODE=FULL_AND_PIECEWISE
COMPILE_MODE=3
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
# Text only: this checkpoint EXL3-quantizes the vision tower as separate
# q/k/v_proj trellises, which the fused-qkv ViT cannot load (boot fails with
# "no module or parameter named 'blocks.0.attn.k_proj'").
FEATURES="language-model-only skip-mm-profiling trust-remote-code prefix-caching mamba-align prompt-tokens-details auto-tool reasoning expert-parallel"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
# EXL3 prefill decodes into a module-level scratch tensor; the shared AOT
# cache would replay one rank's device-bound copy on the others (as 27b-exl3).
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_ROCM_MOE_PREFILL=0
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=0
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; two-shot is not boot-safe under PCIe load.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 4 HW queues (launcher default 2): neutral with the fork kernels off, and it removes
# the per-rank skew that queue sharing at 2 causes with the rdna_mono_* kernels on.
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=0
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
