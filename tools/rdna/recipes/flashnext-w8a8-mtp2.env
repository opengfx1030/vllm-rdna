# Flash-Next (Qwen3.8-Flash-Next-AWQ-W4A16), TP=4 EP=4, MTP=2 + opt-in INT8 W8A8.
# Inherits hardware, port, max-model-len, and MTP=2 settings from
# tools/rdna/recipes/flashnext-mtp2.env and enables the opt-in gfx1030 INT8 W8A8
# prefill / GEMM paths (see csrc/rocm/gemm_w8a8_i8_rdna2.cu).
# Wait until quality + exactness gating passes before promoting to default.
source "$RDSE_RECIPES/flashnext-mtp2.env"

VLLM_RDNA_DENSE_INT8=1
VLLM_RDNA_DENSE_INT8_ONLY=1
VLLM_RDNA_DENSE_W8A8_PREFILL=1
VLLM_RDNA_HC_W8A8_DOWN=1
VLLM_RDNA_HC_W8A8_UP=1
