# Qwen3.8-27B HI2 3.0 bpw (quant_method rdna_hint_flex, BlivionIaG/Qwen3.8-27B-HI2-3.0bpw)
# on two gfx1030 cards, TP=2. Dense hybrid GDN (48 linear-attention + 16 full-attention
# layers). Format, kernels and compute modes: docs/rdna2/rdna-hint-flex-weights.md;
# measurements for this recipe: docs/rdna2/hi2-27b-tp2-2026-11-14.md.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2 MODEL=/path/to/Qwen3.8-27B-HI2-3.0bpw \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2 MTP=2     # drafter = the checkpoint's mtp.* layer
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2 MAXLEN=32768 KV=8589934592
#   VLLM_RDNA_HINT_FLEX_COMPUTE_MODE=i8 bash tools/rdna/serve_rdna.sh RECIPE=27b-hi2-tp2 ...
#
# Memory per rank (a V620 is 29.98 GiB): CPU accounting of the real TP=2 load (rank 1,
#   unique persistent bytes): hi2 codes 3.80 + block params 0.44 + small hi2 fields 0.04,
#   lm_head 1.18, embed_tokens 1.18, rope cache 0.03 = 6.68 GiB. The engine logs "Model
#   loading took 7.46 GiB": 0.78 GiB more, cause not found (the BF16 MTP layer, 0.79 GiB,
#   is the same size: check whether it is loaded at MTP=0). Vision (0.86 GiB) is not
#   loaded with --language-model-only.
# KV cache per rank: 16 full-attention layers x (4 kv heads / TP 2) x 256 head_dim x K+V x
#   2 B = 32 KiB per token, so one 262144-token request (the model's own context, MAXLEN)
#   needs 8 GiB, plus 3 GDN state pages per request (48 layers x 1.5 MiB fp32 SSM + 30 KiB
#   conv = 74 MiB). KV below leaves room for that request plus the prefix cache.

SERVE_ENTRY=cli
SERVED_NAME=q27hi2
PORT=18211
TP=2
HOST=127.0.0.1

MTP=0
ATTN=fa
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
# MAXBAT is derived by the launcher (2048 for an FP16 KV cache: two mamba state blocks).
MAXBAT=
KV=17179869184
GMEM=0.9
RDNA_AR=1
FEATURES="prefix-caching language-model-only"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
# Per-rank JIT: AOT compile hands rank 0's compiled graph to the other ranks on the
# qwen3_next path (TP all-reduce input on cuda:0).
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
# rdna_hint_flex activation path: f16 (spec default), i8 (v_dot4_i32_i8 decode, M <= 48)
# or i8_all (accuracy runs only). docs/rdna2/rdna-hint-flex-weights.md "Compute modes".
VLLM_RDNA_HINT_FLEX_COMPUTE_MODE=f16
# One-shot all-reduce up to 256 KiB, RCCL above. A TP=2 decode step reduces hidden 5120 x
# fp16 = 10 KiB per token (80 KiB at c=8, 240 KiB for a c=8 MTP=2 verify step); prefill
# chunks are 5-20 MiB and stay on RCCL. 2-rank sweep on HIP 2,3 at hidden 5120 (graph replay,
# us per call, one-shot vs RCCL; run during the 2026-11-14 image build, so a same-run relative
# comparison only): 10 KiB 15.3 vs 26.4, 40 KiB 14.9 vs 30.1, 80 KiB 22.5 vs 30.9,
# 240 KiB 29.2 vs 40.8, 640 KiB 62.3 vs 67.3, 1.25 MiB 117.7 vs 114.4. docs/rdna2/hi2-27b-tp2-2026-11-14.md
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
# LM head (124160 x 5120 per rank, no TunableOp row) takes the dense gemv for 9..32 rows
# (MTP verify, 3 rows per request): rocBLAS ran it at 10.4 ms for 12 rows, the gemv at
# 2.9 ms for up to 6 rows (12 rows not measured yet). 8 restores the previous cap.
VLLM_RDNA_LM_HEAD_GEMV_MAX_M=32
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
# Decode-stall cap off, as on 27b-awq and full (TP=2 steps are long; the cap would chunk
# a 16k prefill into small pieces). docs/rdna2/mixed-batch-stall-probe.md
VLLM_RDNA_DECODE_STALL_MS=0
