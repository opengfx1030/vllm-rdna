# Inkling-2-Mini on TWO gfx1030 cards (V620, 29.98 GiB each), TP=2, with persistent decode
# MoE monokernel enabled (`VLLM_INKLING2_MONOKERNEL=1`, `MONO_MAX_ROWS=1`): defaults to plain
# decode (`DSPARK=0`, full 1,048,576-token context) so single-token decode hits the fused
# monokernel path while multi-token batches and prefill stay on the continuous-batching path
# (`docs/rdna2/inkling2-serving.md`).
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp2-mono MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=2,3

DSPARK="${DSPARK:-0}"

# shellcheck source=tools/rdna/recipes/inkling2-mini-tp2.env
source "$RDSE_RECIPES/inkling2-mini-tp2.env"

# --- RDNA vLLM env block ---
VLLM_INKLING2_MONOKERNEL=1
VLLM_INKLING2_MONO_MAX_ROWS="${MONO_MAX_ROWS:-1}"
