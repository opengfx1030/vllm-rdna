# Flash-Next UD-Q4_K_XL GGUF (Unsloth, 104 GiB, 4 shards) + MTP=0, TP4 on gfx1030.
# Loader: --load-format qwen4exp_gguf (vllm/model_executor/model_loader/qwen4exp_gguf_loader.py).
# The GGUF file has no MTP head, so MTP=0 only. Text only (language-model-only).
#
# Needs the plugin FORK, built from source for gfx1030 (the PyPI plugin drops experts
# 256+ in its MMQ MoE kernel: PPL 9.79 instead of 4.80; the seam then stays correct but
# slices large batches, 16k TTFT 21.4 s instead of 8.2 s). The container image has it.
#   opengfx1030/vllm-gguf-plugin, branch rdna_extras. See docs/rdna/serving.md.
#
#   MODEL=<dir with config.json + tokenizer of Qwen3.8-Flash-Next>   (not the GGUF)
#   GGUF_DIR=<dir with the Qwen3.8-Flash-Next-UD-Q4_K_XL-0000N-of-00004.gguf shards>
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-gguf-mtp0
#
# Measured on 4x V620 (2026-11-16, 32768 context, 2 GiB KV = 127,875 tokens): PPL 4.80,
# 1k c=1 ITL 20.3 ms, 16k c=1 TTFT 8.2 s, 1k/512 c=8 186.9 tok/s. 22 GiB weights per card:
# raise KV or MAXLEN only if the card has the room.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-gguf-mtp0 MAXLEN=65536 KV=3221225472

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=0
ATTN=fa
MAXLEN=32768
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=2147483648
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="prefix-caching mamba-align language-model-only"
REQUIRED_VARS="GGUF_DIR"
# JSON without spaces: EXTRA_ARGS is split on whitespace.
EXTRA_ARGS='--load-format qwen4exp_gguf --model-loader-extra-config {"gguf_dir":"'"${GGUF_DIR:-}"'"}'

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; two-shot is not boot-safe under PCIe load.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 4 HW queues (launcher default 2): neutral with the fork kernels off, and it removes
# the per-rank skew that queue sharing at 2 causes with the rdna_mono_* kernels on.
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
