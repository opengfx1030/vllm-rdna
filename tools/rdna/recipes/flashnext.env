# Flash-Next AWQ-W4A16 production serve (no MTP), TP4/EP4 on gfx1030.
# Reference: tools/rdna/serve_gfx1030_flashnext.sh (validated 2026-09-17; and the
# 2026-09-27 MTP comparison where MTP=0 wins at 8x1k/512 c=8).
# Kept separate from flashnext-mtp0 because this launcher runs the full agentic
# tool/reasoning stack on port 18094 (0.0.0.0) with 6 in-flight sequences.
# Runner/graph/attention settings match the validated flashnext-mtp0 recipe:
# V2 model runner, FULL_AND_PIECEWISE (inductor), RDNA_ATTN, 1024-token
# blocks with mamba-aligned prefix caching (on v0.31 the V1 runner + breakable
# graphs + 16-token blocks of the 0.28 config are no longer the tested path).
# PLE n-gram table: upstream EngramConfig.cpu_offload (pinned host, UVA),
# on by default since v0.31. The fork's CPU sidecar (VLLM_PLE_CPU_OFFLOAD,
# VLLM_PLE_QUANT_DIR) is not wired on this branch.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext PORT=18100 KV=6000000000

SERVE_ENTRY=cli
SERVED_NAME=flash-next
PORT=18094
TP=4
HOST=0.0.0.0

MTP=0
ATTN=fa
MAXLEN=
BLOCK_SIZE=1024
SEQS=6
MAXBAT=2048
LPTH=0
KV=7000000000
GMEM=0.90
DIST_TIMEOUT=1800
CG_MODE=FULL_AND_PIECEWISE
COMPILE_MODE=3
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="trust-remote-code prefix-caching mamba-align prompt-tokens-details auto-tool reasoning expert-parallel vision-cap"

ALLOC_CONF=false
# V2 runner, RDNA_ATTN via ATTN=fa (as flashnext-mtp0).
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ROCM_MOE_PREFILL=0
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_FUSED_HC=0
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0

# --- RCCL over PCIe (PIX) ---
NCCL_P2P_LEVEL=pix
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
HSA_FORCE_FINE_GRAIN_PCIE=1

# --- All-reduce: one-shot up to 64 KiB, RCCL above ---
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
