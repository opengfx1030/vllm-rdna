# Inkling-2-Mini (thinkingmachines/Inkling-2-Mini, Inkling2LoopForConditionalGeneration: 24 layers,
# 128 experts, NVFP4 + MXFP8 MoE, vision tower) on ONE gfx1030 card, TP=1, with MoE expert
# offloading (PackedExpertCache + streaming CPU weight load): ONE unified recipe that runs cleanly
# on BOTH 16 GiB GPUs (RX 6800 / 6900 XT / W6800) AND 32 GiB GPUs (Radeon PRO V620).
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-mini-tp1-offload MODEL=/path/to/inkling2-mini \
#     VENV=/path/to/venv HIP_VISIBLE_DEVICES=4
#
# How one recipe covers 16 GiB and 32 GiB:
#   - With EXPERT_SLOTS=48 (37.5% of 128 experts/layer resident on GPU; all 128 experts held in
#     14.59 GiB of pinned host RAM), model load VRAM drops from 18.68 GiB to 9.36 GiB (measured
#     peak 12.94 GiB on a 14.39 GiB cap) and experts load layer-by-layer onto CPU so a 16 GiB card
#     never OOMs during model load.
#   - MAXLEN=65536 boots cleanly on 16 GiB GPUs out of the box (71,099 KV tokens measured at GMEM=0.48).
#   - On 32 GiB GPUs (V620, GMEM=0.92), the KV pool scales to 432,484 tokens out of the box (6.60x
#     concurrency at 65k), or pass MAXLEN=430000 (502,329 KV tokens measured) for ultra-long context.
#
# Switches (env or trailing KEY=value):
#   EXPERT_SLOTS=48           resident GPU slots per layer (1..128; 32 for max KV on 16 GiB, 64 for max hit rate)
#   EXPERT_CACHE_COPY=native  H2D copy backend: native (default, hipMemcpyBatchAsync) or tensor
#   EXPERT_CACHE_PREFETCH=1   async layer-ahead speculative expert prefetching on copy_stream (1=on, 0=off)
#   EXPERT_CACHE_POLICY=lfu_lru  replacement policy: lfu_lru (default) or lru
#   DSPARK=1                  enable DSpark speculative decoding ([[1,2,2],[3,8,0]], recommended on 32 GiB)
#   MAXLEN=430000             override max context on 32 GiB GPUs
#
# Serving guide and measured numbers: docs/rdna2/inkling2-serving.md and
# docs/explore/inkling2-moe-offload-tp1/README.md.

# shellcheck source=tools/rdna/recipes/inkling2-mini-tp1.env
source "$RDSE_RECIPES/inkling2-mini-tp1.env"

MAXLEN=65536
SEQS=8
MAXBAT=512
GMEM=0.90

if [[ ${DSPARK:-0} == 1 ]]; then
    SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]]}'
fi

# --- RDNA vLLM env block ---
VLLM_KV_CACHE_MARGIN_FLOOR_MIB=1536
VLLM_INKLING2_MOE_OFFLOAD_SLOTS="${EXPERT_SLOTS:-48}"
VLLM_INKLING2_MOE_OFFLOAD_COPY="${EXPERT_CACHE_COPY:-native}"
VLLM_INKLING2_MOE_OFFLOAD_POLICY="${EXPERT_CACHE_POLICY:-lfu_lru}"
VLLM_INKLING2_MOE_OFFLOAD_PREFETCH="${EXPERT_CACHE_PREFETCH:-1}"
