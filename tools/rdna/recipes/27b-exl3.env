# Qwen3.8-27B-exl3-3.00bpw (mul1, TP=4) on gfx1030.
# Reference: tools/rdna/serve_gfx1030_exl3_27b.sh (derived from the validated
# bench_results/2026-10-01_exl3-27b-mul1-tp4 recipe).
# FULL_AND_PIECEWISE cudagraphs by default (validated on v0.31, 4x V620);
# EAGER=1 falls back to no torch.compile / cudagraphs.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-exl3 MTP=2 CG_MODE=PIECEWISE

SERVE_ENTRY=api
SERVED_NAME=exl3-27b-mul1
PORT=18105
TP=4
HOST=127.0.0.1

MTP=0
EAGER=0
ATTN=fa
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=20480
MAXBAT=2048
SEQS=8
KVCAP=6000000000
GMEM=0.90
FEATURES="language-model-only skip-mm-profiling trust-remote-code prefix-caching mamba-align"

# EXL3 27B prefers the second PLX (device indices 4..7) on a 4+4 chassis.
HIP_VISIBLE_DEVICES=4,5,6,7

# --- Mandatory HIP stack ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_EXL3_DEBUG=1
# TP=4 allreduce: RCCL PXB + Simple.
NCCL_P2P_LEVEL=pxb
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
