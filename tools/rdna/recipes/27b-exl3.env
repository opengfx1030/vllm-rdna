# Qwen3.8-27B-exl3-3.00bpw (mul1, TP=4) on gfx1030.
# Reference: tools/rdna/serve_gfx1030_exl3_27b.sh (derived from the validated
# bench_results/2026-10-01_exl3-27b-mul1-tp4 recipe).
# FULL_AND_PIECEWISE cudagraphs by default (validated on v0.31, 4x V620);
# EAGER=1 falls back to no torch.compile / cudagraphs.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=27b-exl3 MTP=2

SERVE_ENTRY=api
SERVED_NAME=exl3-27b-mul1
PORT=18105
TP=4
HOST=127.0.0.1

MTP=0
EAGER=0
ATTN=fa
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=20480
MAXBAT=2048
SEQS=8
KVCAP=6000000000
GMEM=0.90
FEATURES="language-model-only skip-mm-profiling trust-remote-code prefix-caching mamba-align"

# --- Mandatory HIP stack ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
# TP=4 allreduce: rdna_ar one-shot up to 64 KiB (decode / small verify
# steps), RCCL PXB + Simple above. The stock custom-AR force flag stays off.
RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
HSA_FORCE_FINE_GRAIN_PCIE=1
NCCL_P2P_LEVEL=pxb
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
VLLM_FORCE_CUSTOM_ALL_REDUCE=0

# Decode-stall cap (dense hybrid): bound prefill tokens in steps that carry
# decodes (dense models fit on all prefill steps). 27B AWQ TP=4 (2026-10-10):
# max decode gap during a 16k prefill 2672 -> 320 ms, 1k c=8 TTFT 4.0 -> 2.8 s;
# cost 16k/1k c=8 aggregate output 41.2 -> 38.0 tok/s (-8 %), TTFT 40 -> 49 s.
# Set 0 to disable. docs/rdna2/mixed-batch-stall-probe.md
VLLM_RDNA_DECODE_STALL_MS=250
