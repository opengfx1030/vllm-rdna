# Inkling-2-Mini HI2 3.5 bpw (quant_method rdna_hint_flex, quantizer
# rdna-hint-flex-quantizer-inkling feat/inkling2-source) on TWO gfx1030 cards (V620,
# 29.98 GiB each), TP=2.  Routed experts INT2/INT4 in the HI2 format; attention,
# embeddings, router, norms, loop controllers and the vision tower bf16.  DSpark
# speculative decoding ON by default with the stock block (K=2 for 1..2 requests,
# dropped cleanly at 3..8 via [[1,2,2],[3,8,0]]); DSPARK=0 is the plain-decoding
# 1,048,576-token boot.  VISION=1 serves images (drops --language-model-only);
# the default text-only boot keeps it.  FULL_AND_PIECEWISE HIP graphs, one-shot
# HIP all-reduce (rdna_ar), prefix caching.
#
# The DSpark draft is the STOCK bf16 mtp.safetensors (54 BF16 tensors): its 3
# layers and Markov head are not quantized and read the target's hidden-state
# taps, which the HI2 serving path writes like the stock one.  prep_serve_dir.sh
# links it into the serve directory; no conversion exists or is needed.
#
# UNRUN as of 2026-11-25: every GPU was leased.  The CPU gates and the serve-dir
# preparation are done (tools/inkling_hi2/README.md sections 1-3, docs/rdna2/
# inkling2-hi2-runtime-receipt.md); the first GPU step is the kernel test of
# section 2.1, then this recipe.  DSPARK=1 and VISION=1 are unmeasured on HI2.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=inkling2-hi2-tp2 \
#     MODEL=~/w4a8_runs/inkling-hi2-runtime/serve-bpw3.5 VENV=/path/to/venv
#   PRINT=1 bash tools/rdna/serve_rdna.sh RECIPE=inkling2-hi2-tp2 MODEL=... \
#     VENV=...   # assemble only, CPU
#
# The model directory is the quantizer's output plus the symlinks of
# tools/inkling_hi2/prep_serve_dir.sh (config.json, index, both shards, tokenizer,
# stock mtp.safetensors).  The loader takes the expert format from config.json's
# quantization_config; no extra switch selects HI2.
#
# Memory, header census of the real 3.5 bpw output (tools/inkling_hi2/validate_dir.py,
# 2026-11-24): experts 10.08 GiB, dense 3.59 GiB, vision 0.59 GiB, MTP 0.59 GiB,
# indexed total 13.67 GiB.  Per rank at TP=2: experts 5.04 GiB + dense (8.02 GiB when
# sharded .. 9.81 GiB replicated) = 8.02-9.81 GiB before KV; a V620 has 29.98 GiB.
# The HI2 KV is the same as the stock model's (16 full-attention layers, 4 KV heads /
# TP 2, head_dim 256, fp16 = 32 KiB/token).  Fill KV in after the first boot logs
# the measured weights; no number here has been measured with HI2 experts.

SERVE_ENTRY=cli
SERVED_NAME=inkling2-hi2
PORT=18225
TP=2
HOST=127.0.0.1
# a2 lease, pinned by PCI bus (AGENTS two-slot table): serve_rdna.sh resolves
# these to HIP indexes at launch, so a moved enumeration cannot pick another
# pair.  The kit's serve.sh passes HIP_VISIBLE_DEVICES explicitly (an explicit
# device list wins over PCI_BUSES) after its lease/quiet/lock/HIP->PCI gate.
PCI_BUSES="d1 d4"

MTP=0
ATTN=none
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=0
SEQS=8
KV=auto
# DSPARK (default 1) is the production card: the stock K=2 block and its 720000
# context/1024-token batch (the mini recipe's numbers; KV is the same).  DSPARK=0
# is plain decoding with the full 1,048,576-token context, the first GPU boot.
if [[ ${DSPARK:-1} == 0 ]]; then
    MAXLEN=1048576
    MAXBAT=320
    SPEC_CONFIG=""
else
    MAXLEN=720000
    MAXBAT=1024
    SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,2,2],[3,8,0]]}'
fi
# 0.92 assumes the server runs alone.  For the two-server layout (stock reference
# resident for the KL/PPL/task-eval steps) both boots must pass GMEM=0.45, else the
# second one never sees 28 GiB free per card (tools/inkling_hi2/README.md step 2).
GMEM=0.92
RDNA_AR=1
# VISION=1 drops --language-model-only and allows one image per prompt; the
# multimodal class then loads model.visual.* from the directory's vision shard.
if [[ ${VISION:-0} == 1 ]]; then
    FEATURES="prefix-caching prompt-tokens-details"
    EXTRA_ARGS='--limit-mm-per-prompt {"image":1}'
else
    FEATURES="prefix-caching language-model-only"
    EXTRA_ARGS='--limit-mm-per-prompt {"image":0}'
fi

# --- RDNA vLLM env block (same as inkling2-mini-tp2) ---
TUNABLEOP=0
VLLM_KV_CACHE_MARGIN_FLOOR_MIB=2048
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
# If the first boot fails in HIP graph capture of the HI2 serving path, rerun with
# EAGER=1 on the command line and report it (FULL_AND_PIECEWISE stays the target).
