# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP4/EP4 on gfx1030.
# Reference: tools/rdna/serve_gfx1030_flashnext_mtp.sh (validated 2026-09-27).
# Public recipe name: flashnext-mtp2. MTP=2 wins at 8x16k/1k c=8.
# PLE n-gram table: PLE=bf16 (default, upstream pinned BF16), PLE=int4 or
# PLE=int4-disk with PLE_QUANT_DIR=<ples_int4>. See docs/rdna2/tuning.md.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-mtp2 MAXLEN=32768 PORT=18100

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 256 KiB, RCCL above. MTP2 verify batches (M=15-24 tokens at
# hidden 2560) are 77-123 KB, past the old 64 KiB gate. ABBA vs 64 KiB at
# 1k/512: c=8 agg 224.1/225.0 vs 217.4/207.4 tok/s, ITL p50 55.6/55.7 vs
# 57.1/57.5 ms; c=6 192.5 vs 175.8 tok/s. See docs/rdna2/async-stall-profile-2026-11-02.md.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 2 HW queues (launcher default). ABBA vs 4 (no --monokernel, so no persistent
# kernel to skew ranks): 16k/1k c=8 TTFT mean 17.7 vs 20.0 s at the same
# aggregate prefill (2065 vs 2071 tok/s), decode -3 to -6 %, ITL p50 +3 %.
# --monokernel raises it back to 4 for the workers (hw_queues knob).
GPU_MAX_HW_QUEUES=2
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
