# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP4/EP4 on gfx1030.
# Reference: tools/rdna/serve_gfx1030_flashnext_mtp.sh (validated 2026-09-27).
# Public recipe name: flashnext-mtp2. MTP=2 wins at 8x16k/1k c=8.
# PLE n-gram table: upstream EngramConfig.cpu_offload (pinned host, UVA),
# on by default since v0.31. The fork's CPU sidecar (VLLM_PLE_CPU_OFFLOAD,
# VLLM_PLE_QUANT_DIR) is not wired on this branch.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-mtp2 MAXLEN=32768 PORT=18100

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_ROCM_MOE_PREFILL=0
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; two-shot is not boot-safe under PCIe load.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
