# Flash-Next AWQ-W4A16 + MTP=2 (spec decode), TP4/EP4 on gfx1030.
# Reference: tools/rdna/serve_gfx1030_flashnext_mtp.sh (validated 2026-09-27).
# Public recipe name: flashnext-mtp2. MTP=2 wins at 8x16k/1k c=8.
# PLE n-gram table: PLE=bf16 (default, upstream pinned BF16), PLE=int4 or
# PLE=int4-disk with PLE_QUANT_DIR=<ples_int4>. See docs/rdna2/tuning.md.
#
# Override any key on the command line, e.g.
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-mtp2 MAXLEN=32768 PORT=18100

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# 9-32 row decode GEMMs with a weight up to 4 MiB (MoE router, GDN in_proj_ba,
# QSA projections) take one split-K kernel instead of rocBLAS GSU + reduction
# (cold-weight graph replay at M=24: router 32.6 -> 23.0 us, in_proj_ba 14.3 ->
# 6.6 us). With the HC down-tile retune, measured at GPU_MAX_HW_QUEUES=4: ITL
# p50 c=8 51.8 -> 50.6 ms, 16k c=8 53.8 -> 51.7 ms. See docs/rdna2/tuning.md.
VLLM_RDNA_SMALLM_GEMM_MAX_BYTES=4194304
# int8-activation MoE prefill from 512 tokens (decode stays W4A16). Serve A/B
# 2026-11-03 (TP4, pipelined QSA on both sides): solo TTFT 4k/16k 1.74/6.95 ->
# 1.53/6.04 s, 16k c8 aggregate prefill 2,147 -> 2,496 tok/s, decode ITL
# unchanged (c1 24.5, c6 44.5, c8 47.7 ms), PPL 4.83 -> 4.86, probes 3/3,
# prefix PASS, concurrency PASS. See docs/rdna2/tuning.md.
VLLM_RDNA2_W4A8_SDOT4=1
# W4A8 MoE GEMM v2: tile 8 plus the whole-K v2 kernel (a 2048-token chunk runs
# tile 4 with the shipped kernel; the cutoff is 4096). Serve A/B 2026-11-03
# (same window, one boot per arm, pipelined QSA + SDOT4 on both sides):
# c1 aggregate prefill 2,440 -> 2,640 tok/s (+8.2 %), c6 2,532 -> 2,744
# (+8.4 %), 16k c8 2,507 -> 2,723 (+8.6 %, TTFT 14.36 -> 12.83 s), decode ITL
# c1 23.7 -> 22.6, c6 43.3 -> 42.4, c8 48.3 -> 46.9 ms, PPL 4.84 -> 4.80,
# probes 3/3, prefix PASS, concurrency PASS. See docs/rdna2/tuning.md.
VLLM_RDNA2_W4A8_BLOCK_M=8
VLLM_RDNA_W4A8_KBLOCK=-1
# One-shot up to 256 KiB, RCCL above. MTP2 verify batches (M=15-24 tokens at
# hidden 2560) are 77-123 KB, past the old 64 KiB gate. ABBA vs 64 KiB at
# 1k/512: c=8 agg 224.1/225.0 vs 217.4/207.4 tok/s, ITL p50 55.6/55.7 vs
# 57.1/57.5 ms; c=6 192.5 vs 175.8 tok/s. See docs/rdna2/async-stall-profile-2026-11-02.md.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=256
VLLM_RDNA_AR_ONESHOT_KB=256
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 4 HW queues (launcher default 2). ABBA 2026-11-06 (TP4, HIP 6-9, one fresh
# boot per arm, order 2/4/4/2, exact-SHA tree c6b1ff354e, greedy, same seeds,
# 0 KFD evictions): ITL median -6.6 / -4.5 / -4.2 % at 1k c1 / c6 / c8 and
# -6.9 / -4.7 % at 16k c1 / c8, each beyond the 2-vs-2 and 4-vs-4 spread; TTFT
# and prefill aggregate within spread; probes, PPL and concurrency PASS; 0
# "Runlist is getting oversubscribed" lines; 5 KFD compute queues per worker
# (3 at 2). Replaces the 2026-11-02 ABBA that picked 2. See
# docs/rdna2/hwq-abba-2026-11-06.md. --monokernel still raises the workers to 4.
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
