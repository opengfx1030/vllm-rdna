# Flash-Next AWQ-W4A16, MTP=0, pipeline-parallel over 3 gfx1030 cards (TP1/PP3).
# Validated on 3x Radeon PRO V620 (venv-7.14.0, rocm7.14-rocblas5.5 TunableOp).
# Profile follows alanoo81/flashnext-v620-pp3 (text-only, 262K, KV sized from
# free memory); flashnext-pp3-mtp2 is the speculative variant.
# PLE layers must sit on stage 0 (Flash-Next: layer 2, any sane partition).
# Stage 0 holds the whole PLE table: PLE=bf16 needs ~95 GB host RAM; on
# smaller hosts use PLE=int4 (or int4-disk) with PLE_QUANT_DIR=<ples_int4>.
# Dense INT8 must run in ONLY mode under PP: keeping the fp16 copy next to
# the int8 shadow OOMs a stage.
# Text-only: the vision encoder sits on stage 0 and its profiling pass does
# not fit next to 16 layers; vision under PP3 is not supported.
#
#   bash tools/rdna/serve_rdna.sh RECIPE=flashnext-pp3 MODEL=/path/to/model \
#       PLE=int4 PLE_QUANT_DIR=/path/to/ples_int4

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=1
PP=3
PP_PARTITION=16,16,16
HOST=127.0.0.1

MTP=0
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=auto
GMEM=0.95
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="prefix-caching mamba-align language-model-only skip-mm-profiling"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=1
VLLM_RDNA_DENSE_INT8_ONLY=1
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
