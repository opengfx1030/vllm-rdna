# Flash-Next AWQ-W4A16 + dynamic MTP drafting (K in [0, 4] per step by batch
# size), TP4/EP4 on gfx1030. Same serving stack as flashnext-mtp2; deltas:
# - MTP=4 with the batch-size K table below (SPEC_EXTRA): K=4 alone, K=2 at
#   2 requests, K=1 at 3-4, K=0 from 5.
# - Capture ladder: every uniform decode total of the table (1..8 tokens: K+1
#   per row) gets a FULL graph; 12/16/24 keep mixed batches on PIECEWISE graphs.
# - KV=4 GiB: MTP=4 needs 3.79 GiB for one 262144-token request (3.75 GiB, the
#   MTP=2 budget, refuses to boot); MAXLEN stays 262144.
#
# Override any key on the command line, e.g. a different K table:
#   SPEC_EXTRA=',"num_speculative_tokens_per_batch_size":[[1,2,4],[3,8,1]]'

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=4
SPEC_EXTRA=',"num_speculative_tokens_per_batch_size":[[1,1,4],[2,2,2],[3,4,1],[5,256,0]]'
CG_SIZES='[1,2,3,4,5,6,7,8,12,16,24]'
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4294967296
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; two-shot is not boot-safe under PCIe load.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
# 4 HW queues (launcher default 2): neutral with the fork kernels off, and it removes
# the per-rank skew that queue sharing at 2 causes with the rdna_mono_* kernels on.
GPU_MAX_HW_QUEUES=4
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
# Decode-stall cap: opt-in here (16k c=8 output -13 % for a 505 -> 341 ms max
# decode gap). See docs/rdna2/mixed-batch-stall-probe.md "Decode-stall cap".
# VLLM_RDNA_DECODE_STALL_MS=250
# VLLM_DECODE_STALL_MAX_OVERHEAD=1.0
