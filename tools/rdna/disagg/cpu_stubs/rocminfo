#
# rocminfo stand-in for the G0 spike servers on a V620-only box (g0a_serve_wrap.sh puts
# this directory first on PATH unless G0A_ROCMINFO_STUB=0). Same content as
# tools/rdna/rdna3/cpu_stubs/rocminfo of feat/hetero-hub.
#
# aiter, imported through flash_attn by vllm/v1/attention/backends/fa_utils.py, runs
# rocminfo at import, takes the first gfx name it prints and raises KeyError when aiter
# does not list it (GPU_ARCHS does not stop it). While a W7800 (gfx1100) was installed
# that was the first agent; on the V620-only box (2026-11-08 case move) it is gfx1030
# and the API server dies in create_model_config. One gfx1100 agent is all aiter has to
# see; nothing but aiter calls rocminfo.
cat <<'EOF'
