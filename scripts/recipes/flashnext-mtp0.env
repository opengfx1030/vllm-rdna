# Flash-Next AWQ-W4A16 + MTP=0 (plain decode), TP4/EP4 on gfx1030.
# Reference: scripts/serve_gfx1030_flashnext_mtp.sh (validated 2026-09-27).
# Public recipe name: flashnext-mtp0. MTP=0 wins at 8x1k/512 c=8.
# Requires VLLM_PLE_QUANT_DIR (int4 PLE n-gram sidecar directory).
#
# Override any key on the command line, e.g.
#   bash scripts/serve_rdna.sh RECIPE=flashnext-mtp0 MAXLEN=32768 PORT=18100

SERVE_ENTRY=api
SERVED_NAME=flash-next
PORT=18096
TP=4
HOST=127.0.0.1

MTP=0
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap"
REQUIRED_VARS="VLLM_PLE_QUANT_DIR"

# --- PLE n-gram sidecar offload ---
VLLM_PLE_CPU_OFFLOAD=1

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_ROCM_MOE_PREFILL=0
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; two-shot is not boot-safe under PCIe load.
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
