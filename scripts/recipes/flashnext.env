# Flash-Next AWQ-W4A16 production serve (no MTP), TP4/EP4 on gfx1030.
# Reference: scripts/serve_gfx1030_flashnext.sh (validated 2026-09-17; and the
# 2026-09-27 MTP comparison where MTP=0 wins at 8x1k/512 c=8).
# Kept separate from flashnext-mtp0 because this launcher runs the full agentic
# tool/reasoning stack on port 18094 with a V1 model runner and 6 in-flight
# sequences; flashnext-mtp0 is the MTP launcher's config with MTP disabled.
# Requires VLLM_PLE_QUANT_DIR (int4 PLE n-gram sidecar directory).
#
# Override any key on the command line, e.g.
#   bash scripts/serve_rdna.sh RECIPE=flashnext PORT=18100 KV=6000000000

SERVE_ENTRY=cli
SERVED_NAME=flash-next
PORT=18094
TP=4
HOST=0.0.0.0

MTP=0
ATTN=none
MAXLEN=
BLOCK_SIZE=16
SEQS=6
MAXBAT=2048
LPTH=0
KV=7000000000
GMEM=0.90
DIST_TIMEOUT=1800
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=0
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="trust-remote-code prefix-caching prompt-tokens-details auto-tool reasoning expert-parallel vision-cap"
REQUIRED_VARS="VLLM_PLE_QUANT_DIR"

ALLOC_CONF=false
# V1 runner + explicit FA-RDNA2 (no --attention-backend).
VLLM_USE_RDNA2_FA=1
VLLM_FA_RDNA2_GQA_DECODE=1
VLLM_USE_V2_MODEL_RUNNER=0
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_USE_BREAKABLE_CUDAGRAPH=1
VLLM_RDNA_FUSED_HC=0

# --- PLE n-gram sidecar offload ---
VLLM_PLE_CPU_OFFLOAD=1
VLLM_PLE_OFFLOAD_READY_TIMEOUT=3600

# --- RCCL over PCIe (PIX) ---
NCCL_P2P_LEVEL=pix
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
HSA_FORCE_FINE_GRAIN_PCIE=1

# --- All-reduce: one-shot up to 64 KiB, RCCL above ---
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
