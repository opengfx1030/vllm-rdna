# Production full-HIP serve: breakable FULL_AND_PIECEWISE graphs (FA-RDNA2 +
# W4A16 + HIP KV + HIP GDN). Reference: scripts/serve_gfx1030_full.sh
# (greedy PASS 3/3 on Qwen3.8-27B-AWQ-INT4, TP=2, 2026-09-09).
# HOST is intentionally empty: this config lets vLLM bind its default host.
#
# Override any key on the command line, e.g.
#   bash scripts/serve_rdna.sh RECIPE=full HIP_VISIBLE_DEVICES=0,1 \
#     MAXLEN=32768 KV=6000000000 MAXBAT=2048

SERVE_ENTRY=cli
SERVED_NAME=
PORT=18094
TP=2
HOST=
HIP_VISIBLE_DEVICES=0,1

MTP=0
ATTN=none
MAXLEN=200000
MIN_MAXLEN=32768
BLOCK_SIZE=16
SEQS=6
MAXBAT=2048
KV=7000000000
GMEM=0.90
DIST_TIMEOUT=1800
ENABLE_PREFIX_CACHING=1
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_AND_PIECEWISE","compile_ranges_endpoints":[]}'
FEATURES="prefix-caching language-model-only skip-mm-profiling trust-remote-code"
ALLOC_CONF=auto

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_RDNA2_FA=1
# Do not hash the live last hybrid GDN+FA page while decode is appending.
VLLM_ROCM_SKIP_LIVE_TAIL_HASH=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
VLLM_USE_BREAKABLE_CUDAGRAPH=1
# GQA multi-head prefill attention (validated faster than varlen/splitk).
VLLM_FA_RDNA2_GQA_MODE=subgroup

# --- RCCL over PCIe (PIX) ---
NCCL_P2P_LEVEL=pix
RCCL_P2P_NET_DISABLE=1
RCCL_P2P_BATCH_ENABLE=1
NCCL_PROTO=Simple
RCCL_MSCCL_ENABLE=0
HSA_FORCE_FINE_GRAIN_PCIE=1

# --- All-reduce: one-shot up to 64 KiB, RCCL above ---
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR=1
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
