# Qwen3.8-27B AWQ-INT4 (compressed-tensors W4A16, dense hybrid GDN) on gfx1030.
# Reference: scripts/serve_gfx1030_27b_dense.sh. No max-model-len (the model's
# own context is used), FA-RDNA2 attention, RDNA2 W4A16/W4A8 GEMMs, prefix
# caching, FULL_AND_PIECEWISE graphs.
#
# Override any key on the command line, e.g.
#   bash scripts/serve_rdna.sh RECIPE=27b-awq MTP=2 W4A8=1
#   bash scripts/serve_rdna.sh RECIPE=27b-awq EAGER=1 MAXLEN=32768
#
# W4A8 knob -> VLLM_RDNA2_W4A8_SDOT4; RDNA_AR knob -> VLLM_RDNA_AR (mapped by
# the entry point so both stay overridable).

SERVE_ENTRY=cli
SERVED_NAME=q27d
PORT=18210
TP=4
HOST=127.0.0.1

MTP=0
ATTN=fa
EAGER=0
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_EXTRA=',"compile_ranges_endpoints":[]'
MAXLEN=
BLOCK_SIZE=1024
SEQS=8
MAXBAT=2048
KV=8000000000
GMEM=0.9
W4A8=0
RDNA_AR=1
FEATURES="prefix-caching mamba-align language-model-only vision-cap"

# --- RDNA vLLM env block ---
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
# One-shot up to 64 KiB, RCCL above; the stock custom-AR force flag stays off.
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
TUNED_CONFIG=1
