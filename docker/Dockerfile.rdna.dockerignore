# Dockerfile-specific allowlist: leave upstream .dockerignore unchanged.
# Include the complete native/Python/Rust source and serving support data, not
# host environments, model downloads, benchmarks, worktrees or agent state.
**
!CMakeLists.txt
!setup.py
!pyproject.toml
!rust-toolchain.toml
!MANIFEST.in
!LICENSE
!README.md
!csrc/
!csrc/**
!cmake/
!cmake/**
!rust/
!rust/**
!requirements/
!requirements/**
!vllm/
!vllm/**
!tools/
!tools/**
!tunableop/
!tunableop/**
!tuned-moe/
!tuned-moe/**

# Reject Git directories AND worktree .git files, including nested checkouts.
**/.git
**/.git/**
**/.venv
**/venv
**/.cache
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/*.egg
**/.eggs
**/.DS_Store

# Never inherit native/Rust/packaging outputs from the host checkout.
/build
/dist
/.deps
/artifacts
/wheel-export
**/cmake-build-*
**/CMakeUserPresets.json
**/*.so
**/*.so.*
**/*.o
**/*.a
rust/target
vllm/vllm-rs
vllm/_version.py
vllm/third_party/triton_kernels
vllm/third_party/deep_gemm
vllm/third_party/fmha_sm100
vllm/third_party/tml_fa4
vllm/third_party/flashmla/flash_mla_interface.py
vllm/vllm_flash_attn/*
!vllm/vllm_flash_attn/__init__.py
!vllm/vllm_flash_attn/flash_attn_interface.py
csrc/**/*.hip
csrc/**/*_hip*
csrc/**/hip_compat.h
csrc/libtorch_stable/moe/marlin_moe_wna16/kernel_*
csrc/cpu/cpu_attn_dispatch_generated.h
vllm/grpc/vllm_engine_pb2.py
vllm/grpc/vllm_engine_pb2_grpc.py
vllm/grpc/vllm_engine_pb2.pyi
